###  https://purl.org/maont/ontologybridge_tech
mao:bridge_tech rdf:type owl:Class ;
                rdfs:subClassOf mao:MA_technique ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty mao:type_of ;
                                  owl:someValuesFrom mao:MA_technique
                                ] ;
                rdfs:comment "The class Bridge represent the concept of “bridge” or referred to as “bridge hand(s)” in traditional Chinese martial arts. The concept is particularly articulated in the Hung Kuen system. The term bridge means the connection between yourself and your opponent. The skill of bridge relates to the ability to manipulate one's own body structure, to control the ranges, amongst others."@en ;
                rdfs:label "Bridge_tech"@en ;
                mao:name_en "Bridge"@en ;
                mao:name_zh "橋法"@zh-hk ;
                mao:otherName_en "Bridge hand"@en .



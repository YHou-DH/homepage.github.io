@prefix : <https://purl.org/maont/ontology> .
@prefix mao: <https://purl.org/maont/ontology> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix schema: <https://schema.org/> .

@base <https://purl.org/maont/ontology> .

<https://purl.org/maont/ontology>
    rdf:type owl:Ontology ;

    ## ── Identity ──────────────────────────────────────────────────
    vann:preferredNamespaceUri "https://purl.org/maont/ontology"^^xsd:anyURI ;
    vann:preferredNamespacePrefix "mao"^^xsd:string ;

    ## ── Versioning ────────────────────────────────────────────────
    owl:versionIRI <https://purl.org/maont/ontology/1.2> ;
    owl:versionInfo "1.2"^^xsd:string ;
    owl:priorVersion <https://purl.org/maont/ontology/1.1> ;

    ## ── Labels & description ──────────────────────────────────────
    dc:title "MAon — Martial Arts Ontology"@en ;
    rdfs:label "MAon — Martial Arts Ontology v1.2"@en ;
    rdfs:comment "An extension of the MAon ontology (v1.1), incorporating generalizable entities descriptive of Northern and Southern Chinese martial arts. This version integrates traditional folk discursive habits with the structured, modernized theories synthesized from the Dictionary of Chinese Martial Arts (Zhongguo Wushu Dacidian, 1990) and the Record of Chinese Martial Arts Fist and Weapon Forms (Zhongguo Wushu Quanxie Lu, 1983)."@en ;

    ## ── License ───────────────────────────────────────────────────
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;

    ## ── Provenance ────────────────────────────────────────────────
    dcterms:creator "Yumeng Hou"^^xsd:string ;
    dcterms:contributor "Luyi Chen"^^xsd:string ;
    dcterms:created "2024-01-01"^^xsd:date ;
    dcterms:issued "2024-01-01"^^xsd:date ;
    dcterms:modified "2026-06-24"^^xsd:date ;
    dcterms:publisher "YH"^^xsd:string ;

    ## ── Citation ──────────────────────────────────────────────────
    dcterms:bibliographicCitation "MAon: Martial Arts Ontology (v1.2). https://purl.org/maont/ontology"^^xsd:string ;

    ## ── Status & source ───────────────────────────────────────────
    bibo:status "unstable"^^xsd:string ;
    dcterms:source <https://purl.org/maont/ontology> ;

    ## ── Documentation ─────────────────────────────────────────────
    rdfs:seeAlso <https://yumenghou.com/resource/ont/MAoCorpus/extract.html> .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2000/01/rdf-schema#description
rdfs:description rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#wikiURL
rdfs:wikiURL rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#sameAs
owl:sameAs rdf:type owl:AnnotationProperty ;
           rdfs:label "owl:sameAs"@en .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


###  https://purl.org/maont/ontologyarchivist_note
mao:archivist_note rdf:type owl:AnnotationProperty ;
                   rdfs:comment "A free-text annotation note about an individual or class, e.g. editorial remarks, caveats, or comparison notes."@en ;
                   rdfs:label "archivist_note"@en ;
                   mao:name_zh "備註"@zh-hk ;
                   rdfs:range xsd:string .


###  https://purl.org/maont/ontologycharacteristics
mao:characteristics rdf:type owl:AnnotationProperty ;
                    rdfs:label "characteristics"@en ;
                    mao:has_description "description" ;
                    mao:name_zh "特點"@zh-hk .


###  https://purl.org/maont/ontologycharacteristics_zh
mao:characteristics_zh rdf:type owl:AnnotationProperty ;
                       rdfs:comment "description_zh"@zh-hk ;
                       rdfs:label "characteristics_zh"@en ;
                       rdfs:subPropertyOf mao:characteristics .


###  https://purl.org/maont/ontologyclassificationRule
mao:classificationRule rdf:type owl:AnnotationProperty ;
                       rdfs:comment "Records the rationale or rule used to assign the TypeClass to an individual."@en ;
                       rdfs:label "classificationRule"@en ;
                       mao:name_zh "分類規則"@zh-hk ;
                       rdfs:range xsd:string .


###  https://purl.org/maont/ontologyhas_description
mao:has_description rdf:type owl:AnnotationProperty ;
                    rdfs:comment "A human-readable description of the individual, intended as a more field-level annotation than rdfs:comment. Mirrors the 'description' column in the HKMALA schema."@en ;
                    rdfs:label "has_description"@en ;
                    mao:name_zh "描述"@zh-hk ;
                    rdfs:subPropertyOf rdfs:comment ;
                    rdfs:range xsd:string .


###  https://purl.org/maont/ontologyhas_resource
mao:has_resource rdf:type owl:AnnotationProperty ;
                 rdfs:comment "A URL or file-path pointing to a media resource (video, image, book chapter) that demonstrates or documents the individual."@en ;
                 rdfs:label "has_resource"@en ;
                 mao:name_zh "資源連結"@zh-hk ;
                 rdfs:range xsd:string .


###  https://purl.org/maont/ontologyname_en
mao:name_en rdf:type owl:AnnotationProperty ;
            rdfs:label "name_en"@en ;
            mao:name_zh "英文名稱"@zh-hk .


###  https://purl.org/maont/ontologyname_romanCAN
mao:name_romanCAN rdf:type owl:AnnotationProperty ;
                  rdfs:label "romanCAN"@en ;
                  mao:name_zh "粵語羅馬字"@zh-hk .


###  https://purl.org/maont/ontologyname_romanMAN
mao:name_romanMAN rdf:type owl:AnnotationProperty ;
                  rdfs:label "name_romanMAN"@en ;
                  mao:name_zh "漢語拼音"@zh-hk .


###  https://purl.org/maont/ontologyname_zh
mao:name_zh rdf:type owl:AnnotationProperty ;
            rdfs:label "name_zh"@en ;
            mao:name_zh "中文名稱"@zh-hk .


###  https://purl.org/maont/ontologyorigin_story
mao:origin_story rdf:type owl:AnnotationProperty ;
                 rdfs:label "origin_story"@en ;
                 mao:name_zh "源流"@zh-hk .


###  https://purl.org/maont/ontologyotherName_en
mao:otherName_en rdf:type owl:AnnotationProperty ;
                 rdfs:label "otherName_en"@en ;
                 mao:name_zh "英文別稱"@zh-hk .


###  https://purl.org/maont/ontologyotherName_zh
mao:otherName_zh rdf:type owl:AnnotationProperty ;
                 rdfs:label "otherName_zh"@en ;
                 mao:name_zh "中文別稱"@zh-hk .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


###  https://purl.org/maont/ontologyname_originalLang
mao:name_originalLang rdf:type rdfs:Datatype ;
                      rdfs:comment "The original-language name form of an appellation."@en ;
                      rdfs:label "name_originalLang"@en .


#################################################################
#    Object Properties
#################################################################

###  https://purl.org/maont/ontologyadapts
mao:adapts rdf:type owl:ObjectProperty ;
           rdfs:domain mao:MA_master ;
           rdfs:range mao:MA_style ,
                      mao:MA_syllabus ,
                      mao:armament ,
                      mao:training_method ,
                      mao:training_tool ;
           rdfs:comment "The adapts property refers to the relation that a Master adapts certain (existing) techniques, training methods like forms and form sets, weapons, training tools, or even a style or system."@en ;
           rdfs:label "adapts"@en ;
           mao:name_zh "修改"@zh-hk .


###  https://purl.org/maont/ontologyadopts
mao:adopts rdf:type owl:ObjectProperty ;
           rdfs:domain mao:MA_institute ,
                       mao:MA_style ,
                       mao:MA_syllabus ,
                       mao:MA_system ;
           rdfs:range mao:training_method ;
           rdfs:comment "The property adopts is essentially the verb adopt, signifying that a martial arts system or style adopts a training method, or a transmission institute or syllabus adopts a training method."@en ;
           rdfs:label "adopts"@en ;
           mao:name_zh "采用"@zh-hk .


###  https://purl.org/maont/ontologybelongs_to
mao:belongs_to rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain mao:MA_style ,
                           mao:MA_system ;
               rdfs:range mao:MA_system ;
               rdfs:label "belongs_to"@en .


###  https://purl.org/maont/ontologycreates
mao:creates rdf:type owl:ObjectProperty ;
            rdfs:domain mao:MA_master ;
            rdfs:range mao:MA_style ,
                       mao:MA_syllabus ,
                       mao:armament ,
                       mao:training_method ,
                       mao:training_tool ;
            rdfs:comment "The creates property refers to the relation that a Master creates certain (new) techniques, training methods like forms and form sets, weapons, training tools, or even a style or system."@en ;
            rdfs:label "creates"@en ;
            mao:name_zh "創造"@zh-hk ;
            mao:otherName_zh "創建"@zh-hk .


###  https://purl.org/maont/ontologydeveloped_from
mao:developed_from rdf:type owl:ObjectProperty ;
                   rdfs:domain mao:MA_style ;
                   rdfs:range mao:MA_style ;
                   rdfs:label "developed_from"@en .


###  https://purl.org/maont/ontologydocuments
mao:documents rdf:type owl:ObjectProperty ;
              rdfs:domain mao:MA_book ;
              rdfs:range mao:MA_master ,
                         mao:MA_institute ,
                         mao:MA_style ,
                         mao:MA_system ,
                         mao:MA_technique ,
                         mao:training_method ;
              rdfs:label "documents"@en ;
              mao:name_zh "記錄"@zh-hk .


###  https://purl.org/maont/ontologyemploys
mao:employs rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain mao:MA_technique ;
            rdfs:range mao:MA_technique ;
            rdfs:comment "Instances of Techniques, particularly Combo_tech, acquire the identity of a combo technique with a collective impact of its technical components. To capture these characteristics, we use the employs property to indicate that a more complex instance of Technique is fulfilled by employing another or several other basic ones."@en ;
            rdfs:label "employs"@en ;
            mao:name_zh "運用"@zh-hk .


###  https://purl.org/maont/ontologyemploysBodyshape
mao:employsBodyshape rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf mao:employs ;
                     rdfs:domain mao:MA_technique ;
                     rdfs:range mao:body_shape ;
                     rdfs:comment "Specifies the overall body configuration (身型) employed during a technique. Subproperty of mao:employs."@en ;
                     rdfs:label "employsBodyshape"@en ;
                     mao:name_zh "運用身形"@zh-hk .


###  https://purl.org/maont/ontologyemploysHandshape
mao:employsHandshape rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf mao:employs ;
                    rdfs:domain mao:MA_technique ;
                    rdfs:range mao:handshape ;
                    rdfs:comment "Specifies the handshape (手形) employed by a technique. Subproperty of mao:employs, narrowing the range to mao:handshape."@en ;
                    rdfs:label "employs handshape"@en ;
                    mao:name_zh "運用手形"@zh-hk .

###  https://purl.org/maont/ontologyemploysGesture
mao:employsGesture rdf:type owl:ObjectProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    owl:equivalentProperty mao:employsHandshape ;
    rdfs:label "employs gesture"@en ;
    rdfs:comment "Deprecated property retained for backward compatibility. Use mao:employsHandshape instead."@en ;
    dcterms:isReplacedBy mao:employsHandshape .

###  https://purl.org/maont/ontologyemploysStance
mao:employsStance rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf mao:employs ;
                  rdfs:domain mao:MA_technique ;
                  rdfs:range mao:stance ;
                  rdfs:comment "Specifies the stance (步形) employed during a technique. Subproperty of mao:employs."@en ;
                  rdfs:label "employsStance"@en ;
                  mao:name_zh "運用步形"@zh-hk .


###  https://purl.org/maont/ontologyfeatures_in
mao:features_in rdf:type owl:ObjectProperty ;
                rdfs:domain mao:Form_move ,
                            mao:Form_set ,
                            mao:MA_master ,
                            mao:MA_institute ,
                            mao:armament ,
                            mao:training_tool ;
                rdfs:range mao:Digital_document ,
                           mao:MA_book ;
                rdfs:label "features_in"@en .


###  https://purl.org/maont/ontologyhas
mao:has rdf:type owl:ObjectProperty ;
        rdfs:domain mao:MA_style ,
                    mao:MA_system ;
        rdfs:range mao:MA_style ,
                   mao:MA_syllabus ;
        rdfs:label "has"@en .


###  https://purl.org/maont/ontologyhasSideA
mao:hasSideA rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf mao:has ;
             rdfs:domain mao:sparring_set ;
             rdfs:range mao:spar_sequence ;
             rdfs:comment "Links a sparring_set to one or more spar_sequence instances on side A. Cardinality of this property equals the number of persons on side A."@en ;
             rdfs:label "hasSideA"@en ;
             mao:name_zh "甲方"@zh-hk .


###  https://purl.org/maont/ontologyhasSideB
mao:hasSideB rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf mao:has ;
             rdfs:domain mao:sparring_set ;
             rdfs:range mao:spar_sequence ;
             rdfs:comment "Links a sparring_set to one or more Spar_sequence instances on side B. Cardinality of this property equals the number of persons on side B."@en ;
             rdfs:label "hasSideB"@en ;
             mao:name_zh "乙方"@zh-hk .


###  https://purl.org/maont/ontologyhasStyle
mao:hasStyle rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf mao:has ;
             rdfs:domain mao:MA_technique ;
             rdfs:range mao:MA_style ;
             rdfs:comment "Indicates that a technique instance belongs to or is characteristic of a specific martial arts style. Declared as a subproperty of mao:used_in, which has the same domain/range but broader coverage."@en ;
             rdfs:label "hasStyle"@en ;
             mao:name_zh "属于流派"@zh-hk .


###  https://purl.org/maont/ontologyhas_birthplace
mao:has_birthplace rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf mao:has ;
                   rdfs:domain mao:MA_master ;
                   rdfs:range mao:E53_place ;
                   rdfs:label "has_birthplace"@en .


###  https://purl.org/maont/ontologyhas_component
mao:has_component rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf mao:has ;
                  rdfs:domain mao:Form_move ,
                              mao:MA_syllabus ;
                  rdfs:range mao:MA_technique ;
                  rdfs:comment "A form, whether static or dynamic, is a choreographed pattern of movement comprising a unitary sequence of basic techniques. Hence, the conventional interpretation is that a form has several technical components while simultaneously serving as a training tool for those techniques and the qualities relevant to fulfilling them. The property has component is used; it is designed to inherit the CIDOC-CRM declaration of P148 has component and to indicate the relationship between a form and the technique(s) trained within."@en ;
                  rdfs:label "has_component"@en ;
                  mao:name_zh "包含"@zh-hk .


###  https://purl.org/maont/ontologyhas_form
mao:has_form rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf mao:has ;
             rdfs:domain mao:MA_style ;
             rdfs:range mao:Form_set ;
             rdfs:label "has_form"@en ;
             mao:name_zh "有套路"@zh-hk .


###  https://purl.org/maont/ontologyhas_fundamental_tech
mao:has_fundamental_tech rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf mao:has ;
                         rdfs:domain mao:MA_style ;
                         rdfs:range mao:MA_technique ;
                         rdfs:label "has_fundamental_tech"@en ;
                         mao:name_zh "有基本功"@zh-hk .


###  https://purl.org/maont/ontologyhas_intent
mao:has_intent rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf mao:has ;
               rdfs:domain mao:Form_move ,
                           mao:MA_technique ;
               rdfs:range mao:MA_tactic ;
               rdfs:comment "The class MA_Tactic addresses the former case, in combination with the property has intent to describe an instance of Form or Technique that embodies the intent to achieve specific tactics, such as attacking, defending, deflecting, controlling distance, or complex maneuvers."@en ;
               rdfs:label "has_intent"@en ;
               mao:name_zh "意圖"@zh-hk .


###  https://purl.org/maont/ontologyhas_origin_place
mao:has_origin_place rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf mao:has ;
                     rdfs:domain mao:MA_style ,
                                 mao:MA_system ;
                     rdfs:range mao:E53_place ;
                     rdfs:label "has_origin_place"@en .


###  https://purl.org/maont/ontologyhas_principle
mao:has_principle rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf mao:has ;
                  rdfs:domain mao:MA_style ,
                              mao:MA_system ;
                  rdfs:range mao:MA_principle ;
                  rdfs:label "has_principle"@en ;
                  mao:name_zh "有原則"@zh-hk .


###  https://purl.org/maont/ontologyhas_verse
mao:has_verse rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf mao:has ;
              rdfs:domain mao:Form_set ;
              rdfs:range mao:MA_verse ;
              rdfs:label "has_verse"@en .


###  https://purl.org/maont/ontologyhas_symbol
mao:has_symbol rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf mao:has ;
               rdfs:domain mao:MA_style ,
                           mao:MA_system ;
               rdfs:range mao:symbolic_animal ;
               rdfs:label "has_symbol"@en ;
               mao:name_zh "有象徵"@zh-hk .


###  https://purl.org/maont/ontologyhas_work
mao:has_work rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf mao:has ;
             rdfs:domain mao:MA_master ;
             rdfs:range mao:MA_book ;
             rdfs:label "has_work"@en ;
             mao:name_zh "有作品"@zh-hk .


###  https://purl.org/maont/ontologyidentified_by
mao:identified_by rdf:type owl:ObjectProperty ;
                  rdfs:domain mao:E21_Person ;
                  rdfs:range mao:E41_appellation ;
                  rdfs:label "identified_by"@en .


###  https://purl.org/maont/ontologyimitates
mao:imitates rdf:type owl:ObjectProperty ;
             rdfs:range mao:symbolic_animal ;
             rdfs:comment "Certain techniques, forms, or styles are considered to imitate specific creatures or living things, for instance, through their relation to classes like symbolic_animal"@en ;
             rdfs:label "imitates"@en ;
             mao:name_zh "模仿"@zh-hk .


###  https://purl.org/maont/ontologyin_collection
mao:in_collection rdf:type owl:ObjectProperty ;
                  rdfs:domain mao:E31_document ;
                  rdfs:range mao:E78.Collection ;
                  rdfs:label "in_collection"@en .


###  https://purl.org/maont/ontologyin_form
mao:in_form rdf:type owl:ObjectProperty ;
            rdfs:domain mao:Form_move ;
            rdfs:range mao:Form_set ;
            rdfs:label "in_form"@en ;
            mao:name_zh "在套路中"@zh-hk .


###  https://purl.org/maont/ontologyinfluences
mao:influences rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain mao:MA_style ,
                           mao:MA_system ;
               rdfs:range mao:MA_style ,
                          mao:MA_system ;
               rdfs:label "influences"@en .


###  https://purl.org/maont/ontologyis
mao:is rdf:type owl:ObjectProperty ;
       rdfs:label "is"@en .


###  https://purl.org/maont/ontologyis_child_of
mao:is_child_of rdf:type owl:ObjectProperty ;
                rdfs:label "is_child_of"@en .


###  https://purl.org/maont/ontologyis_master_of
mao:is_master_of rdf:type owl:ObjectProperty ;
                 rdfs:domain mao:MA_master ;
                 rdfs:range mao:MA_master ;
                 rdfs:label "is_master_of"@en .


###  https://purl.org/maont/ontologyis_member_of
mao:is_member_of rdf:type owl:ObjectProperty ;
                 rdfs:domain mao:MA_master ;
                 rdfs:range mao:MA_clan ;
                 rdfs:label "is_member_of"@en .


###  https://purl.org/maont/ontologyis_parent_of
mao:is_parent_of rdf:type owl:ObjectProperty ;
                 rdfs:domain mao:MA_master ;
                 rdfs:range mao:MA_master ;
                 rdfs:label "is_parent_of"@en .


###  https://purl.org/maont/ontologyis_student_of
mao:is_student_of rdf:type owl:ObjectProperty ;
                  rdfs:domain mao:MA_master ;
                  rdfs:range mao:MA_master ;
                  rdfs:label "is_student_of"@en .


###  https://purl.org/maont/ontologylives_in_ts
mao:lives_in_ts rdf:type owl:ObjectProperty ;
                rdfs:domain mao:MA_master ;
                rdfs:range mao:E52_timespan ;
                rdfs:label "lives_in_ts"@en .


###  https://purl.org/maont/ontologylocated_at
mao:located_at rdf:type owl:ObjectProperty ;
               rdfs:domain mao:MA_institute ;
               rdfs:range mao:E53_place ;
               rdfs:label "located_at"@en .


###  https://purl.org/maont/ontologyparticipated_in
mao:participated_in rdf:type owl:ObjectProperty ;
                    rdfs:domain mao:E21_Person ,
                                mao:E74.Group ;
                    rdfs:range mao:E5.Event ;
                    rdfs:label "participated_in"@en ;
                    rdfs:seeAlso "http://www.cidoc-crm.org/cidoc-crm/P11i_participated_in"@en .


###  https://purl.org/maont/ontologypracticed_in
mao:practiced_in rdf:type owl:ObjectProperty ;
                 rdfs:domain mao:Form_set ;
                 rdfs:range mao:MA_style ;
                 rdfs:comment "The practiced_in property signifies that an instance of Form_set is practised in a specific style."@en ;
                 rdfs:label "trained_in_style"@en ;
                 mao:name_zh "習練于"@zh-hk .


###  https://purl.org/maont/ontologypractices
mao:practices rdf:type owl:ObjectProperty ;
              rdfs:domain mao:MA_master ;
              rdfs:range mao:MA_style ,
                         mao:MA_system ;
              rdfs:comment "The practices property signifies that a Master is known to practise a certain style or system."@en ;
              rdfs:label "practices"@en ;
              mao:name_zh "習練"@zh-hk .


###  https://purl.org/maont/ontologypresent_at
mao:present_at rdf:type owl:ObjectProperty ;
               rdfs:domain mao:E22_man_made_obj ,
                           mao:E73.Information_Object ;
               rdfs:range mao:E5.Event ;
               rdfs:label "present_at"@en ;
               rdfs:seeAlso "http://www.cidoc-crm.org/cidoc-crm/P12i_was_present_at"@en .


###  https://purl.org/maont/ontologyrepresents
mao:represents rdf:type owl:ObjectProperty ;
               rdfs:domain mao:Form_move ;
               rdfs:range mao:MA_principle ;
               rdfs:comment """The execution of a form, occasionally a technique alone, represents certain tactical intents or guiding principles underlying the movement rationale of a martial arts style. The property represents is used to connect an instance of Form to one of MA_principle, indicating that the technical movements follow a specific guiding principle or a combination of several.
The property represents in MAon shares a similar interpretation with the P138 represents declared in CIDOC-CRM. However, their domains differ, as observed thus far. The represents here establishes connections between two E89 Propositional Objects, typically linking one E89 Propositional Object with an E28 Conceptual Object."""@en ;
               rdfs:label "represents"@en ;
               mao:name_zh "體現"@zh-hk .


###  https://purl.org/maont/ontologyresides_in
mao:resides_in rdf:type owl:ObjectProperty ;
               rdfs:domain mao:MA_master ;
               rdfs:range mao:E53_place ;
               rdfs:label "resides_in"@en .



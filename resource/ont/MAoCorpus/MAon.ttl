###  https://purl.org/maont/ontologyE21_Person
mao:E21_Person rdf:type owl:Class ;
               rdfs:subClassOf owl:Thing ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mao:creates ;
                                 owl:someValuesFrom mao:E22_man_made_obj
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mao:identified_by ;
                                 owl:someValuesFrom mao:E41_appellation
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mao:lives_in_ts ;
                                 owl:someValuesFrom mao:E52_timespan
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mao:resides_in ;
                                 owl:someValuesFrom mao:E53_place
                               ] ;
               rdfs:comment "A human individual, aligned with CIDOC-CRM E21 Person. In MAon, this is the superclass of MA_Master. Use MA_Master for known martial arts practitioners. Use E21_Person only for peripheral figures such as family members or historical persons who are not martial artists themselves."@en ;
               rdfs:label "E21.Person"@en ;
               rdfs:seeAlso <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E21> .



                mao:name_en "Syllabus (martial arts)"@en ;
                mao:name_zh "武術教學大綱"@zh-hk .


###  https://purl.org/maont/ontologyMA_system
mao:MA_system rdf:type owl:Class ;
              rdfs:subClassOf owl:Thing ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:adopts ;
                                owl:someValuesFrom mao:training_method
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:belongs_to ;
                                owl:someValuesFrom mao:MA_system
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:has ;
                                owl:someValuesFrom mao:MA_style
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:has ;
                                owl:someValuesFrom mao:MA_syllabus
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:has_origin_place ;
                                owl:someValuesFrom mao:E53_place
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:has_principle ;
                                owl:someValuesFrom mao:MA_principle
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:has_symbol ;
                                owl:someValuesFrom mao:symbolic_animal
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:influences ;
                                owl:someValuesFrom mao:MA_style
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:influences ;
                                owl:someValuesFrom mao:MA_system
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:taught_at ;
                                owl:someValuesFrom mao:MA_institute
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:transmitted_in_place ;
                                owl:someValuesFrom mao:E53_place
                              ] ;
              rdfs:comment "The class MA_system represents an upper-level systemic grouping of different martial arts styles. A system is a whole tradition or art, not a single lineage. Concrete examples: Hung Kuen (洪拳), Choy Li Fut (蔡李佛), White Crane Kung Fu (白鶴拳), Southern Chinese Martial Arts (南拳), Chinese Martial Arts. Styles within a system typically share a consistent methodological framework and principles. DISAMBIGUATION: MA_system > MA_style > MA_Master. A person is never an MA_system. A named branch or family lineage is MA_style, not MA_system."@en ;
              rdfs:label "MA_System"@en ;
              mao:characteristics "system_characteristics"@en ;
              mao:characteristics_zh "system_characteristics_zh"@zh-hk ;
              mao:name_en "Martial Arts System"@en ;
              mao:name_zh "武術系統"@zh-hk .


###  https://purl.org/maont/ontologyMA_tactic
mao:MA_tactic rdf:type owl:Class ;
              rdfs:subClassOf mao:E73.Information_Object ;
              rdfs:comment "A tactical intent or combat application goal, describing what the practitioner is trying to achieve with a technique or movement. Examples: attacking while blocking (連消帶打), closing the distance (逼近), controlling the opponent (擒拿控制). Distinguished from MA_principle, which is a guiding movement philosophy rather than a combat objective."@en ;
              rdfs:label "MA_Tactic"@en ;
              mao:name_en "Tactic"@en ;
              mao:name_zh "戰術"@zh-hk .


###  https://purl.org/maont/ontologyMA_technique
mao:MA_technique rdf:type owl:Class ;
                 rdfs:subClassOf owl:Thing ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:employs ;
                                   owl:someValuesFrom mao:bodywork
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:employs ;
                                   owl:someValuesFrom mao:bridge_tech
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:employs ;
                                   owl:someValuesFrom mao:footwork
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:employs ;
                                   owl:someValuesFrom mao:handwork
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:has_intent ;
                                   owl:someValuesFrom mao:MA_tactic
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:practiced_in ;
                                   owl:someValuesFrom mao:training_method
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:similar_to ;
                                   owl:someValuesFrom mao:MA_technique
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:used_in ;
                                   owl:someValuesFrom mao:MA_style
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:used_in ;
                                   owl:someValuesFrom mao:MA_system
                                 ] ;
                 rdfs:comment "The class Technique is designed to function as a connector between different modules, establishing connections between general kinetic elements, technical interpretations, stylistic expressions, and methods of training, application, teaching, and documentation. This class expands four major categorical subclasses: Handwork, Footwork, Bodywork, and Bridge, each aiming o provide an embodied understanding of the techniques' structure. Accordingly, most instances of Technique are subsumed under one of the three principal categories given which anatomical part is substantially involved."@en ;
                 rdfs:label "MA_Technique"@en ;
                 mao:name_en "Martial Arts Technique"@en ;
                 mao:name_zh "技術"@zh-hk .



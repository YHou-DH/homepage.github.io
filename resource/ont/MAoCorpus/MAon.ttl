mao:E41_appellation rdf:type owl:Class ;
                    rdfs:label "E41.Appellation"@en ;
                    rdfs:seeAlso <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E41> .


###  https://purl.org/maont/ontologyE5.Event
mao:E5.Event rdf:type owl:Class ;
             rdfs:comment "This class comprises distinct, delimited and coherent processes and interactions of a material nature, in cultural, social or physical systems. Typical examples are meetings, births, deaths, actions of decision taking, making or inventing things, but also more complex and extended ones such as conferences, elections, building of a castle, or battles."@en ;
             rdfs:label "E5.Event"@en ;
             rdfs:seeAlso "http://www.cidoc-crm.org/cidoc-crm/E5_Event"@en .


###  https://purl.org/maont/ontologyE52_timespan
mao:E52_timespan rdf:type owl:Class ;
                 rdfs:label "E52.Time-Span"@en ;
                 rdfs:seeAlso <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E52> .


###  https://purl.org/maont/ontologyE53_place
mao:E53_place rdf:type owl:Class ;
              rdfs:comment "A geographic or administrative location, aligned with CIDOC-CRM E53 Place. Used to record birthplaces, origin places, and transmission locations of styles, systems, and masters."@en ;
              rdfs:label "E53.Place"@en ;
              rdfs:seeAlso <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E53> .


###  https://purl.org/maont/ontologyE73.Information_Object
mao:E73.Information_Object rdf:type owl:Class ;
                           rdfs:label "E73.Information Object"@en ;
                           rdfs:seeAlso <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E73> .


###  https://purl.org/maont/ontologyE74.Group
mao:E74.Group rdf:type owl:Class ;
              rdfs:comment """This class comprises any gatherings or organizations of human individuals or groups that act collectively or in a similar way due to any form of unifying relationship. In the wider sense this class also comprises official positions which used to be regarded in certain contexts as one actor, independent of the current holder of the office, such as the president of a country. In such cases, it may happen that the group never had more than one member. A joint pseudonym (i.e. a name that seems indicative of an individual but that is actually used as a persona by two or more people) is a particular case of E74 Group.
A gathering of people becomes an instance of E74 Group when it exhibits organizational characteristics usually typified by a set of ideas or beliefs held in common, or actions performed together. These might be communication, creating some common artifact, a common purpose such as study, worship, business, sports, etc. Nationality can be modelled as membership in an instance of E74 Group. Married couples and other concepts of family are regarded as particular examples of E74 Group."""@en ;
              rdfs:label "E74.Group"@en ;
              rdfs:seeAlso "http://www.cidoc-crm.org/cidoc-crm/E74_Group"@en .


###  https://purl.org/maont/ontologyE77_persistent_item
mao:E77_persistent_item rdf:type owl:Class ;
                        rdfs:label "E77.Persistent Item"@en ;
                        rdfs:seeAlso <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E77> .


###  https://purl.org/maont/ontologyE78.Collection
mao:E78.Collection rdf:type owl:Class ;
                   rdfs:comment "This class comprises aggregations of instances of E18 Physical Thing that are assembled and maintained (“curated” and “preserved,” in museological terminology) by one or more instances of E39 Actor over time for a specific purpose and audience, and according to a particular collection development plan. Typical instances of curated holdings are museum collections, archives, library holdings and digital libraries."@en ;
                   rdfs:label "E78.Collection"@en ;
                   rdfs:seeAlso "https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E78"@en .


###  https://purl.org/maont/ontologyExhibition
mao:Exhibition rdf:type owl:Class ;
               rdfs:subClassOf mao:E5.Event ;
               rdfs:label "Exhibition"@en .


###  https://purl.org/maont/ontologyForm_move
mao:Form_move rdf:type owl:Class ;
              rdfs:subClassOf mao:training_method ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:has_component ;
                                owl:someValuesFrom mao:MA_technique
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:has_intent ;
                                owl:someValuesFrom mao:MA_tactic
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:in_form ;
                                owl:someValuesFrom mao:Form_set
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:represents ;
                                owl:someValuesFrom mao:MA_principle
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:similar_movement_to ;
                                owl:someValuesFrom mao:Form_move
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:type_of ;
                                owl:someValuesFrom mao:training_method
                              ] ;
              rdfs:comment "The class Form_movement encapsulates the concept of shi. Shi signifies the individual units of movement within a training form, which is a fundamental aspect of technical and stylistic training in traditional martial arts. Examples of this class include zhaoshi (or shi) in Chinese terminology. An instance of form movement, whether static or dynamic, is a choreographed pattern of movement comprising a unitary sequence of basic techniques. It typically involves a movement that employs several techniques, simultaneously serving as a training tool for those techniques and the qualities relevant to fulfilling them. The property has component is used; it is designed to inherit the CIDOC-CRM declaration of P148 has component and to indicate the relationship between a form_movement and the technique(s) trained within."@en ;
              rdfs:label "Form_movement"@en ;
              mao:name_en "Shi"@en ;
              mao:name_zh "招式"@zh-hk ;
              mao:otherName_en "Form movement"@en ,
                               "zhaoshi"@en ;
              mao:otherName_zh "式"@zh-hk .


###  https://purl.org/maont/ontologyForm_set
mao:Form_set rdf:type owl:Class ;
             rdfs:subClassOf mao:training_method ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mao:belongs_to ;
                               owl:someValuesFrom mao:MA_system
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mao:features_in ;
                               owl:someValuesFrom mao:MA_book
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mao:has_component ;
                               owl:someValuesFrom mao:Form_move
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mao:has_verse ;
                               owl:someValuesFrom mao:MA_verse
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mao:practiced_in ;
                               owl:someValuesFrom mao:MA_style
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mao:similar_set_of ;
                               owl:someValuesFrom mao:Form_set
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mao:type_of ;
                               owl:someValuesFrom mao:training_method
                             ] ;
             rdfs:comment "The class Form_set addresses the concept of form set (often referred to as form) -– the sequential arrangement of form movements. Commonly known as the Chinese term taolu and its Japanese equivalent, kata. An instance of Form_set features a set routine of multiple instances of Form_movement in sequential order. While most form sets are designed for individual practice, some also serve as interactive sparring exercises, represented through the class Sparring_set."@en ;
             rdfs:label "Form_set"@en ;
             mao:name_en "Form set"@en ;
             mao:name_zh "套路"@zh-hk ;
             mao:otherName_en "Taolu"@en ,
                              "kata"@en ;
             mao:otherName_zh "拳套"@zh-hk .


###  https://purl.org/maont/ontologyInteractive_system
mao:Interactive_system rdf:type owl:Class ;
                       rdfs:subClassOf mao:E22_man_made_obj ;
                       rdfs:label "Interactive_system"@en .


###  https://purl.org/maont/ontologyMA_book
mao:MA_book rdf:type owl:Class ;
            rdfs:subClassOf mao:E31_document ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:documents ;
                              owl:someValuesFrom mao:E53_place
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:documents ;
                              owl:someValuesFrom mao:MA_master
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:documents ;
                              owl:someValuesFrom mao:MA_institute
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:documents ;
                              owl:someValuesFrom mao:MA_style
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:documents ;
                              owl:someValuesFrom mao:MA_system
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:documents ;
                              owl:someValuesFrom mao:training_method
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:type_of ;
                              owl:someValuesFrom mao:MA_book
                            ] ;
            rdfs:comment "The class MA_Document encompasses a variety of information objects that record aspects of martial arts. These can be either physical or digital and include ancient manuscripts, books, manuals, and audiovisual contents, amongst others. It's important to note that an instance of MA_Document may behold identities. We bridge the class with the CIDOC-CRM E31 Document to facilitate flexible interoperations and potential acquisition of additional data, and facilitates semantic enrichment of other linked data sources through assertion or inference rules."@en ;
            rdfs:label "MA_Document"@en ;
            mao:name_en "Martial Arts Document"@en ;
            mao:name_zh "武術文檔"@zh-hk .


###  https://purl.org/maont/ontologyMA_clan
mao:MA_clan rdf:type owl:Class ;
            rdfs:subClassOf mao:E74.Group ;
            rdfs:comment "A martial arts clan is a patrilineal or discipleship lineage group founded around a specific master or family. Clans typically share training norms and honour codes and may maintain their own transmission records. Examples: Lam Family Hung Kuen, Hung Sing Choy Lay Fut."@en ;
            rdfs:label "MA_Clan"@en ;
            mao:name_en "Martial Arts Clan"@en ;
            mao:name_zh "家族譜系"@zh-hk ;
            mao:otherName_en "Martial Arts Family"@en .



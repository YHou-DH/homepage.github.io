###  https://purl.org/maont/ontology/taming_tiger_15
mao:taming_tiger_15 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:has_component mao:dw_block_n_target_hand ,
                                      mao:facing_sun_palm ,
                                      mao:horse_stance ,
                                      mao:stabilizing_bridge ;
                    mao:has_intent mao:defense_block ,
                                   mao:reconciliation_block ;
                    mao:is_form_in mao:Gung_Gee_Fook_Fu_Kuen ;
                    mao:represents mao:inch_bridge ,
                                   mao:steady_bridge ,
                                   mao:straight_bridge ;
                    rdfs:description "第四次抛踭後，雙掌手腕按至腰下，順勢前上平出標手，後沉橋對膊，雙手變四指撐天。攻胸手法，若敵出拳打我中部，可以標掌直出迎擊，連消帶打。"@zh ;
                    rdfs:label "taming_tiger_15" ;
                    mao:name_en "Downward double-palm block followed by the forward target hands and facing-the-sun palms"@en ;
                    mao:name_zh "四拋標串撐天指"@zh .


###  https://purl.org/maont/ontology/taming_tiger_16
mao:taming_tiger_16 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:has_component mao:db_curving_palm ,
                                      mao:db_splitting_palms ,
                                      mao:divide_punch ,
                                      mao:horse_stance ;
                    mao:has_intent mao:attack_while_defend ,
                                   mao:reconciliation_redirection ;
                    mao:is_form_in mao:Gung_Gee_Fook_Fu_Kuen ;
                    mao:represents mao:hard_bridge ,
                                   mao:move_bridge ,
                                   mao:separating_bridge ;
                    rdfs:description "雙掌胸前交叉挑手平肩，再各自向外下方割手至腰；後雙手抽拳抱胸前，接左右分金搥，雙拳拳背向外左右打出，實戰中可變化為邊搥。"@zh ;
                    rdfs:label "taming_tiger_16" ;
                    mao:name_en "Double splitting and curving palms followed by the divide punch"@en ;
                    mao:name_zh "雙抽雙割一揸分"@zh .



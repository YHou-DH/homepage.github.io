                    rdfs:label "taming_tiger_57" ;
                    mao:name_en "Double reverse knife hand strike following the block"@en ;
                    mao:name_zh "一撇一劃千字手"@zh .


###  https://purl.org/maont/ontology/taming_tiger_58
mao:taming_tiger_58 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:is_form_in mao:Gung_Gee_Fook_Fu_Kuen ;
                    mao:similar_movement_to mao:taming_tiger_43 ;
                    rdfs:description "接扭馬抽拳，吊左脚、拳對右膊；再疾上左子午馬，打出雙掛搥；再接扭馬割手至腰，疾上左子午馬雙掌向上插頸喉。"@zh ;
                    rdfs:label "taming_tiger_58" ;
                    mao:name_en "Striking with the double hanging back fists and then knife hand thrust"@en ;
                    mao:name_zh "拉馬抽拳雙掛落"@zh .


###  https://purl.org/maont/ontology/taming_tiger_59

                             mao:Form_move ;
                    mao:is_form_in mao:Gung_Gee_Fook_Fu_Kuen ;
                    mao:similar_movement_to mao:taming_tiger_44 ;
                    rdfs:description "右扭身落四平馬，接著兩踭向外一兜，雙手變虎爪；後上前落左子午馬，雙撐掌向前上方打出。"@zh ;
                    rdfs:label "taming_tiger_59" ;
                    mao:name_en "Advancing with double palm/claw strike"@en ;
                    mao:name_zh "進馬兜肘雙虎爪"@zh .


###  https://purl.org/maont/ontology/taming_tiger_6
mao:taming_tiger_6 rdf:type owl:NamedIndividual ,

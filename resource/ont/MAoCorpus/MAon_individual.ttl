###  https://purl.org/maont/ontology/taming_tiger_1
mao:taming_tiger_1 rdf:type owl:NamedIndividual ,
                            mao:Form_move ;
                   mao:has_intent mao:breath_regulation ;
                   mao:is_form_in mao:Gung_Gee_Fook_Fu_Kuen ;
                   rdfs:description "預備式，身體立正，雙手自然貼身下垂，雙脚平開一寸，頸正頭平，氣沉丹田。"@zh ;
                   rdfs:label "taming_tiger_1" ;
                   mao:name_en "Standing with the feet about one inch apart"@en ;
                   mao:name_zh "合脚離開一寸闊"@zh .


###  https://purl.org/maont/ontology/taming_tiger_10
mao:taming_tiger_10 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:has_component mao:horse_stance ;
                    mao:is_form_in mao:Gung_Gee_Fook_Fu_Kuen ;
                    rdfs:description "雙拳在腰，四步開馬至雙脚距月三個腳掌的長度，落身坐四平大馬，脚尖平行向前，大腿與地面平行，膝蓋不超過腳尖。"@zh ;
                    rdfs:label "taming_tiger_10" ;
                    mao:name_en "Posing a horse stance in four steps"@en ;
                    mao:name_zh "腳肘開發落四平"@zh .


###  https://purl.org/maont/ontology/taming_tiger_11
mao:taming_tiger_11 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:has_component mao:db_blocking_palm ,
                                      mao:horse_stance ;
                    mao:has_intent mao:defense_block ;
                    mao:is_form_in mao:Gung_Gee_Fook_Fu_Kuen ;
                    mao:represents mao:hard_bridge ;
                    rdfs:description "提雙拳至胸前，雙拳化掌，掌心朝下，雙膀手切落至腰。守中掌法，截打中路來拳。"@zh ;
                    rdfs:label "taming_tiger_11" ;
                    mao:name_en "Pulling up fists to throw the lower double forearm block"@en ;
                    mao:name_zh "抽拳在胸雙切膀"@zh .


###  https://purl.org/maont/ontology/taming_tiger_12
mao:taming_tiger_12 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:has_component mao:facing_sun_palm ,
                                      mao:finger_hand ,
                                      mao:horse_stance ,
                                      mao:stabilizing_bridge ;
                    mao:is_form_in mao:Gung_Gee_Fook_Fu_Kuen ;
                    mao:represents mao:steady_bridge ;
                    rdfs:description "雙手由中綫穿上（亦說挑上），合掌護胸，後分開成雙指手平肩，再成四指撐天掌，沉踭逼力于掌、橋、指。"@zh ;
                    rdfs:label "taming_tiger_12" ;
                    mao:name_en "Palms up facing each other followed by the stabilizing bridge"@en ;
                    mao:name_zh "合掌分開定金橋"@zh .


###  https://purl.org/maont/ontology/taming_tiger_13

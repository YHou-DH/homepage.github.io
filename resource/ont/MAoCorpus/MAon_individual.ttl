                   rdfs:label "taming_tiger_6" ;
                   mao:name_en "Descending the elbows with the palms facing the sun"@en ;
                   mao:name_zh "沉踭一定指撐天"@zh .


###  https://purl.org/maont/ontology/taming_tiger_60
mao:taming_tiger_60 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:is_form_in mao:Gung_Gee_Fook_Fu_Kuen ;
                    mao:similar_movement_to mao:taming_tiger_45 ;
                    rdfs:description "左吊馬，右手拉拳橫向左肩，左爪收至左肩；上左子午馬，右橫邊搥拉至前額成牛角搥，左手握拳擺後；接左拳從後向前衝拳，同時牛角搥向下按至胸前，雙手成十字交叉。"@zh ;
                    rdfs:label "taming_tiger_60" ;
                    mao:name_en "Striking with a hook and uppercut"@en ;
                    mao:name_zh "牛角一槌轉通天"@zh .



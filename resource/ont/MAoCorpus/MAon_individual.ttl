###  https://purl.org/maont/ontology/taming_tiger_36
mao:taming_tiger_36 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:has_component mao:bow_stance ,
                                      mao:cat_stance ,
                                      mao:double_claws ,
                                      mao:mirror_palm ,
                                      mao:serial_upper_claws ,
                                      mao:whipping_palm ;
                    mao:has_intent mao:attack_subduing ,
                                   mao:reconciliation_redirection ;

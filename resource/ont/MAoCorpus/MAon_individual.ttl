#################################################################
#    Individuals
#################################################################

###  https://purl.org/maont/ontology/Book_Gung_Gee_Fook_Fu_Kuen_by_Lam_Sai_Wing
mao:Book_Gung_Gee_Fook_Fu_Kuen_by_Lam_Sai_Wing rdf:type owl:NamedIndividual ,
                                                        mao:ManualBook ;
                                               mao:documents mao:Gung_Gee_Fook_Fu_Kuen ,
                                                             mao:Hung_Kuen ,
                                                             mao:Lam_Sai_Wing ;
                                               rdfs:label "Book:Gung_Gee_Fook_Fu_Kuen_by_Lam_Sai_Wing" .


###  https://purl.org/maont/ontology/Choy_Li_Fut
mao:Choy_Li_Fut rdf:type owl:NamedIndividual ,
                         mao:MA_system ;
                mao:belongs_to mao:Southern_Chinese_Martial_Arts ;
                rdfs:label "Choy_Li_Fut" ;
                rdfs:wikiURL "https://en.wikipedia.org/wiki/Choy_Li_Fut" ;
                mao:name_en "Choy Li Fut" ;
                mao:name_zh "蔡李佛" .


###  https://purl.org/maont/ontology/Dan_Tien_focus
mao:Dan_Tien_focus rdf:type owl:NamedIndividual ,
                            mao:breath_principle ;
                   mao:used_in mao:Choy_Li_Fut ,
                               mao:Hung_Kuen ,
                               mao:White_Crane_Kungfu ;
                   rdfs:label "Dan_Tien_focus" ;
                   mao:name_en "Dan Tien focus"@en ;
                   mao:name_zh "氣沉丹田"@zh .


###  https://purl.org/maont/ontology/GungGee_video_OscarLam
mao:GungGee_video_OscarLam rdf:type owl:NamedIndividual ,
                                    mao:Video ;
                           rdfs:label "GungGee_video_OscarLam" .


###  https://purl.org/maont/ontology/Gung_Gee_Fook_Fu_Kuen
mao:Gung_Gee_Fook_Fu_Kuen rdf:type owl:NamedIndividual ,
                                   mao:Form_set ;
                          mao:belongs_to mao:Hung_Kuen ;
                          mao:practiced_in mao:Lam_Family_Hung_Kuen ;
                          rdfs:label "Gung_Gee_Fook_Fu_Kuen"@en ;
                          mao:name_en "Gung Gee Fook Fu Kuen"@en ;
                          mao:name_zh "工字伏虎拳"@zh ;
                          mao:otherName_en "Taming the Tiger in I-Pattern"@en .


###  https://purl.org/maont/ontology/Hung_Kuen
mao:Hung_Kuen rdf:type owl:NamedIndividual ,
                       mao:MA_system ;
              mao:belongs_to mao:Southern_Chinese_Martial_Arts ;
              mao:has_principle mao:Dan_Tien_focus ,
                                <https://purl.org/maont/ontology/12_bridges> ;
              mao:has_symbol mao:Snake ,
                             mao:dragon ,
                             mao:leopard ,
                             mao:tiger ,
                             mao:white_crane ;
              rdfs:label "Hung_Kuen" ;
              rdfs:wikiURL "https://de.wikipedia.org/wiki/Hung_Kuen" ;
              mao:name_en "Hung Kuen" ;
              mao:name_zh "洪拳"@zh ;
              mao:otherName_en "Hung Gar,Hung Ga"@en ;
              mao:otherName_zh "洪家,洪家拳"@zh .


###  https://purl.org/maont/ontology/Lam_Family_Hung_Kuen
mao:Lam_Family_Hung_Kuen rdf:type owl:NamedIndividual ,
                                  mao:MA_style ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mao:is ;
                                    owl:someValuesFrom mao:MA_style
                                  ] ;
                         mao:belongs_to mao:Hung_Kuen ;
                         rdfs:label "Lam_Family_Hung_Kuen" ;
                         mao:name_en "Lam Family Hung Kuen"@en ;
                         mao:name_zh "林家洪拳" .


###  https://purl.org/maont/ontology/Lam_Sai_Wing
mao:Lam_Sai_Wing rdf:type owl:NamedIndividual ,
                          mao:MA_Master ;
                 rdfs:label "Lam_Sai_Wing" .


###  https://purl.org/maont/ontology/Snake
mao:Snake rdf:type owl:NamedIndividual ,
                   mao:symbolic_animal ;
          rdfs:label "Snake" .


###  https://purl.org/maont/ontology/Southern_Chinese_Martial_Arts
mao:Southern_Chinese_Martial_Arts rdf:type owl:NamedIndividual ,
                                           mao:MA_system ;
                                  rdfs:label "Southern_Chinese_Martial_Arts" ;
                                  rdfs:wikiURL "https://en.wikipedia.org/wiki/Styles_of_Chinese_martial_arts" ;
                                  mao:name_en "Southern Chinese Martial Arts" ,
                                              "中國南派武術" ;
                                  mao:otherName_en "Southern styles" ;
                                  mao:otherName_zh "南拳" .


###  https://purl.org/maont/ontology/T_backfist_n_punch
mao:T_backfist_n_punch rdf:type owl:NamedIndividual ,
                                mao:combo_tech ;
                       mao:employs mao:backfist_n_punch_combo ,
                                   mao:reverse_hanging_fist ,
                                   mao:stepping ;
                       mao:used_in mao:Hung_Kuen ;
                       rdfs:label "T_backfist_n_punch" ;
                       mao:name_en "Side/reverse backfist block followed by a straight punch"@en ;
                       mao:name_romanCAN "Ban Zi Gwaa Daa"@en ;
                       mao:name_romanMAN "Pin Zi Gua Da"@en ;
                       mao:name_zh "品字掛打"@zh .


###  https://purl.org/maont/ontology/Uprightness
mao:Uprightness rdf:type owl:NamedIndividual ,
                         mao:honor_code ;
                rdfs:label "Uprightness"@en .


###  https://purl.org/maont/ontology/White_Crane_Kungfu
mao:White_Crane_Kungfu rdf:type owl:NamedIndividual ,
                                mao:MA_system ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty mao:teaches ;
                                  owl:someValuesFrom mao:breathing_tech
                                ] ;
                       mao:belongs_to mao:Southern_Chinese_Martial_Arts ;
                       mao:has_origin_place <https://purl.org/maont/ontology/YongChun(place)> ;
                       mao:has_principle mao:Dan_Tien_focus ;
                       mao:has_symbol mao:white_crane ;
                       rdfs:label "White_Crane_Kungfu"@en ;
                       rdfs:wikiURL "https://en.wikipedia.org/wiki/Fujian_White_Crane" ;
                       mao:name_en "White Crane Kungfu" ;
                       mao:name_zh "白鶴拳" .



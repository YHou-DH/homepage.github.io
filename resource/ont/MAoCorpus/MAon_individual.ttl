                    mao:represents mao:move_bridge ,
                                   mao:pressure_bridge ,
                                   mao:subdue_bridge ;
                    rdfs:description "掌心向内成“美人照鏡”，接右脚踏前子午馬，雙手成虎爪，右為前爪，左後爪置右踭位置，連續向前劃抓三次。接右脚吊馬冚擸手，再轉右子午馬向前出雙爪手。"@zh ;
                    rdfs:label "taming_tiger_36" ;
                    mao:name_en "Reconciling using the looking-in-the-mirror palm followed by double tiger claw strikes to the opponent's face"@en ;
                    mao:name_zh "照鏡手法爪三勻"@zh .


###  https://purl.org/maont/ontology/taming_tiger_37
mao:taming_tiger_37 rdf:type owl:NamedIndividual ,

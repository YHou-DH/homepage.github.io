@prefix : <https://purl.org/maont/ontology/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix mao: <https://purl.org/maont/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <https://purl.org/maont/ontology/> .

<https://purl.org/maont/ontology_individual> rdf:type owl:Ontology ;
                                              owl:imports <https://purl.org/maont/ontology> .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2000/01/rdf-schema#description
rdfs:description rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#wikiURL
rdfs:wikiURL rdf:type owl:AnnotationProperty .


###  https://purl.org/maont/ontology/name_en
mao:name_en rdf:type owl:AnnotationProperty .


###  https://purl.org/maont/ontology/name_romanCAN
mao:name_romanCAN rdf:type owl:AnnotationProperty .


###  https://purl.org/maont/ontology/name_romanMAN
mao:name_romanMAN rdf:type owl:AnnotationProperty .


###  https://purl.org/maont/ontology/name_zh
mao:name_zh rdf:type owl:AnnotationProperty .


###  https://purl.org/maont/ontology/otherName_en
mao:otherName_en rdf:type owl:AnnotationProperty .


###  https://purl.org/maont/ontology/otherName_zh
mao:otherName_zh rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://purl.org/maont/ontology/belongs_to
mao:belongs_to rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/documents
mao:documents rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/employs
mao:employs rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/has_component
mao:has_component rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/has_intent
mao:has_intent rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/has_origin_place
mao:has_origin_place rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/has_principle
mao:has_principle rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/has_symbol
mao:has_symbol rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/in_form
mao:in_form rdf:type owl:ObjectProperty ;
            owl:inverseOf mao:is_form_in .


###  https://purl.org/maont/ontology/is
mao:is rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/is_form_in
mao:is_form_in rdf:type owl:ObjectProperty ;
               rdfs:domain mao:Form_move ;
               rdfs:range mao:Form_set ;
               rdfs:comment "Inverse of mao:in_form. Links a Form_move individual to the Form_set it belongs to."@en ;
               rdfs:label "is_form_in"@en .


###  https://purl.org/maont/ontology/practiced_in
mao:practiced_in rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/represents
mao:represents rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/similar_movement_to
mao:similar_movement_to rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/similar_to
mao:similar_to rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/teaches
mao:teaches rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/type_of
mao:type_of rdf:type owl:ObjectProperty .


###  https://purl.org/maont/ontology/used_in
mao:used_in rdf:type owl:ObjectProperty .



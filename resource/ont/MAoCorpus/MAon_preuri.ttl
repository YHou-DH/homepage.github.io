               mao:ontoMA_otherName_zh "肘法"@zh-cn ;
               rdfs:comment "Elbow techniques denote the techniques that use the elbow joint, usually in tandem with coherent moves in the forearm."@en ;
               rdfs:label "Elbow_tech" .


###  http://EncodingActs.github.io/annotated/MAon/eye_tech
mao:eye_tech rdf:type owl:Class ;

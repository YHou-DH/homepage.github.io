               :name_en "Body shape"@en ;
               mao:ontoMA_name_zh "身型"@zh ;
               rdfs:comment "Body shape (身型) denotes a static or quasi-static overall configuration of the body used in attack, defence or transitional positioning — e.g. frontal body (正身), side body (侧身). Distinguished from bodywork (身法), which refers to dynamic body movement methods."@en ;
               rdfs:label "Body_shape"@en .



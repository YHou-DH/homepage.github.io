###  http://EncodingActs.github.io/annotated/MAon/MA_form
mao:MA_form rdf:type owl:Class ;
            rdfs:subClassOf mao:training_method ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:has_component ;
                              owl:someValuesFrom mao:MA_technique
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:has_intent ;
                              owl:someValuesFrom mao:MA_tactic
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:in_form ;
                              owl:someValuesFrom mao:Form_set
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:represents ;
                              owl:someValuesFrom mao:MA_principle
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:similar_movement_to ;
                              owl:someValuesFrom mao:MA_form
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty mao:type_of ;
                              owl:someValuesFrom mao:training_method
                            ] ;
            :name_en "Form movement"@en ;
            mao:ontoMA_name_zh "招式"@zh-hk ;
            mao:ontoMA_otherName_en "kata"@en ,
                                    "zhaoshi"@en ;
            mao:ontoMA_otherName_zh "式"@zh-hk ;
            rdfs:comment "The class Form_movement encapsulates the concept of individual units of movement within a training form – a fundamental aspect of technical and stylistic training in traditional martial arts. Examples of this class include zhaoshi (or shi) in Chinese terminology. An instance of form movement, whether static or dynamic, is a choreographed pattern of movement comprising a unitary sequence of basic techniques. It typically involves a movement that employs several techniques, simultaneously serving as a training tool for those techniques and the qualities relevant to fulfilling them. The property has component is used; it is designed to inherit the CIDOC-CRM declaration of P148 has component and to indicate the relationship between a form_movement and the technique(s) trained within."@en ;
            rdfs:label "Form_movement"@en .


###  http://EncodingActs.github.io/annotated/MAon/MA_institute
mao:MA_institute rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:adopts ;
                                   owl:someValuesFrom mao:MA_syllabus
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:adopts ;
                                   owl:someValuesFrom mao:training_method
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:located_at ;
                                   owl:someValuesFrom mao:E53_place
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:teaches ;
                                   owl:someValuesFrom mao:MA_style
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty mao:teaches ;
                                   owl:someValuesFrom mao:MA_system
                                 ] ;
                 :name_en "Martial Arts Institute"@en ;
                 mao:ontoMA_name_zh "武術機構"@zh-hk ;
                 rdfs:comment "The class MA_institute conceptualizes any collective social agent where martial arts teaching, training, assessment, or dissemination occurs, e.g. a school, clan, sect, or sports federation. Instances of this class typically have a physical location, represented by the property located at to relate to a place, accordingly subsuming the CIDOC-CRM assertions about E53 Place and P156 occupies."@en ;
                 rdfs:label "MA_institute" .


###  http://EncodingActs.github.io/annotated/MAon/MA_principle
mao:MA_principle rdf:type owl:Class ;
                 rdfs:subClassOf owl:Thing ;
                 :name_en "Principle (martial arts)"@en ;
                 mao:ontoMA_name_zh "原則"@zh-hk ;
                 rdfs:comment "MA_principle pertains to the guiding principles that underlie the movement rationale of specific techniques or a style in general, typically varying among different martial arts styles and systems."@en ;
                 rdfs:label "MA_principle" .


###  http://EncodingActs.github.io/annotated/MAon/MA_style

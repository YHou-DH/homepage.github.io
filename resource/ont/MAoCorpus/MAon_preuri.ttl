@prefix : <http://EncodingActs.github.io/annotated/MAon#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix mao: <http://EncodingActs.github.io/annotated/MAon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://EncodingActs.github.io/annotated/MAon#> .

<http://EncodingActs.github.io/annotated/MAon> rdf:type owl:Ontology ;
                                                rdfs:comment "Integrated MAon ontology incorporating the HKMALA extension. Class URIs use a flat mao: namespace (no class: sub-prefix). Properties employsBodyPart and employsHands replace earlier hasBodyPart/hasHandUsage. April 2026 revision."@en ;
                                                rdfs:label "MAon — Martial Arts Ontology (integrated with HKMALA extension, v2)"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://EncodingActs.github.io/annotated/MAon#name_en
:name_en rdf:type owl:AnnotationProperty ;
         rdfs:label "name_en"@en .


###  http://EncodingActs.github.io/annotated/MAon#name_romanCAN
:name_romanCAN rdf:type owl:AnnotationProperty ;
               rdfs:label "romanCAN"@en .


###  http://EncodingActs.github.io/annotated/MAon#name_romanMAN
:name_romanMAN rdf:type owl:AnnotationProperty .


###  http://EncodingActs.github.io/annotated/MAon/has_classificationRule
mao:has_classificationRule rdf:type owl:AnnotationProperty ;
                           rdfs:comment "Records the rationale or rule used to assign the TypeClass to an individual."@en ;
                           rdfs:label "has_classificationRule"@en ,
                                      "分类规则"@zh ;
                           rdfs:range xsd:string .


###  http://EncodingActs.github.io/annotated/MAon/has_description
mao:has_description rdf:type owl:AnnotationProperty ;
                    rdfs:comment "A human-readable description of the individual, intended as a more field-level annotation than rdfs:comment. Mirrors the 'description' column in the HKMALA schema."@en ;
                    rdfs:label "has_description"@en ,
                               "描述"@zh ;
                    rdfs:subPropertyOf rdfs:comment ;
                    rdfs:range xsd:string .


###  http://EncodingActs.github.io/annotated/MAon/has_note
mao:has_note rdf:type owl:AnnotationProperty ;
             rdfs:comment "A free-text annotation note about an individual or class, e.g. editorial remarks, caveats, or comparison notes."@en ;
             rdfs:label "has_note"@en ,
                        "备注"@zh ;
             rdfs:range xsd:string .


###  http://EncodingActs.github.io/annotated/MAon/has_resource
mao:has_resource rdf:type owl:AnnotationProperty ;
                 rdfs:comment "A URL or file-path pointing to a media resource (video, image, book chapter) that demonstrates or documents the individual."@en ;
                 rdfs:label "has_resource"@en ,
                            "资源链接/来源"@zh ;
                 rdfs:range xsd:string .


###  http://EncodingActs.github.io/annotated/MAon/ontoMA_name_zh
mao:ontoMA_name_zh rdf:type owl:AnnotationProperty ;
                   rdfs:label "name_zh"@zh .


###  http://EncodingActs.github.io/annotated/MAon/ontoMA_otherName_en
mao:ontoMA_otherName_en rdf:type owl:AnnotationProperty ;
                        rdfs:label "otherName_en"@en .


###  http://EncodingActs.github.io/annotated/MAon/ontoMA_otherName_zh
mao:ontoMA_otherName_zh rdf:type owl:AnnotationProperty ;
                        rdfs:label "otherName_zh"@zh .


###  http://www.w3.org/2000/01/rdf-schema#baiduURL
rdfs:baiduURL rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#description
rdfs:description rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#wikiURL
rdfs:wikiURL rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#sameAs
owl:sameAs rdf:type owl:AnnotationProperty ;
           rdfs:label "owl:sameAs" .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://EncodingActs.github.io/annotated/MAon/ArtName
mao:ArtName rdf:type rdfs:Datatype ;
            rdfs:label "ArtName" .


###  http://EncodingActs.github.io/annotated/MAon/CN_S_Name
mao:CN_S_Name rdf:type rdfs:Datatype ;
              rdfs:label "CN_S_Name" .


###  http://EncodingActs.github.io/annotated/MAon/CN_T_name
mao:CN_T_name rdf:type rdfs:Datatype ;
              rdfs:label "CN_T_name" .


###  http://EncodingActs.github.io/annotated/MAon/EN_Name
mao:EN_Name rdf:type rdfs:Datatype ;
            rdfs:label "EN_Name" .


###  http://EncodingActs.github.io/annotated/MAon/Image
mao:Image rdf:type rdfs:Datatype ;
          rdfs:label "Image" .


###  http://EncodingActs.github.io/annotated/MAon/ManualBook
mao:ManualBook rdf:type rdfs:Datatype ;
               rdfs:label "ManualBook" .


###  http://EncodingActs.github.io/annotated/MAon/MoCap
mao:MoCap rdf:type rdfs:Datatype ;
          rdfs:label "MoCap" .


###  http://EncodingActs.github.io/annotated/MAon/Texts
mao:Texts rdf:type rdfs:Datatype ;
          rdfs:label "Texts" .


###  http://EncodingActs.github.io/annotated/MAon/Video
mao:Video rdf:type rdfs:Datatype ;
          rdfs:label "Video" .


###  http://EncodingActs.github.io/annotated/MAon/attack_control
mao:attack_control rdf:type rdfs:Datatype .


###  http://EncodingActs.github.io/annotated/MAon/attack_n_defend
mao:attack_n_defend rdf:type rdfs:Datatype ;
                    rdfs:label "attack_n_defend" .


###  http://EncodingActs.github.io/annotated/MAon/bladed_weapon
mao:bladed_weapon rdf:type rdfs:Datatype .


###  http://EncodingActs.github.io/annotated/MAon/body_manipulation
mao:body_manipulation rdf:type rdfs:Datatype ;
                      rdfs:label "body_manipulation" .


###  http://EncodingActs.github.io/annotated/MAon/body_movement
mao:body_movement rdf:type rdfs:Datatype ;
                  rdfs:label "body_movement" .


###  http://EncodingActs.github.io/annotated/MAon/body_positioning
mao:body_positioning rdf:type rdfs:Datatype ;
                     rdfs:label "body_positioning" .


###  http://EncodingActs.github.io/annotated/MAon/body_posture
mao:body_posture rdf:type rdfs:Datatype ;
                 rdfs:label "body_posture" .


###  http://EncodingActs.github.io/annotated/MAon/distance_management
mao:distance_management rdf:type rdfs:Datatype .


###  http://EncodingActs.github.io/annotated/MAon/distance_timing
mao:distance_timing rdf:type rdfs:Datatype ;
                    rdfs:label "distance_timing" .


###  http://EncodingActs.github.io/annotated/MAon/empty_hand_set
mao:empty_hand_set rdf:type rdfs:Datatype ;
                   rdfs:label "empty_hand_set" .


###  http://EncodingActs.github.io/annotated/MAon/grading_system
mao:grading_system rdf:type rdfs:Datatype ;
                   rdfs:label "grading_system" .


###  http://EncodingActs.github.io/annotated/MAon/name_originalLang
mao:name_originalLang rdf:type rdfs:Datatype ;
                      rdfs:label "name_originalLang" .


###  http://EncodingActs.github.io/annotated/MAon/positioning
mao:positioning rdf:type rdfs:Datatype ;
                rdfs:label "positioning" .


###  http://EncodingActs.github.io/annotated/MAon/ranking_system
mao:ranking_system rdf:type rdfs:Datatype ;
                   rdfs:label "ranking_system" .


###  http://EncodingActs.github.io/annotated/MAon/reputation
mao:reputation rdf:type rdfs:Datatype ;
               rdfs:label "reputation" .


###  http://EncodingActs.github.io/annotated/MAon/spaer_weapon
mao:spaer_weapon rdf:type rdfs:Datatype ;
                 rdfs:label "spaer_weapon" .


###  http://EncodingActs.github.io/annotated/MAon/sparring_set
mao:sparring_set rdf:type rdfs:Datatype .


###  http://EncodingActs.github.io/annotated/MAon/staff_weapon
mao:staff_weapon rdf:type rdfs:Datatype ;
                 rdfs:label "staff_weapon" .


###  http://EncodingActs.github.io/annotated/MAon/weapon_set
mao:weapon_set rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://EncodingActs.github.io/annotated/MAon/adapts
mao:adapts rdf:type owl:ObjectProperty ;
           rdfs:domain mao:MA_Master ;
           rdfs:range mao:MA_style ,
                      mao:MA_syllabus ,
                      mao:armament ,
                      mao:training_method ,
                      mao:training_tool ;
           mao:ontoMA_name_zh "修改"@zh-hk ;
           rdfs:comment "The adapts property refers to the relation that a Master adapts certain (existing) techniques, training methods like forms and form sets, weapons, training tools, or even a style or system."@en ;
           rdfs:label "adapts" .


###  http://EncodingActs.github.io/annotated/MAon/adopts
mao:adopts rdf:type owl:ObjectProperty ;
           rdfs:domain mao:MA_institute ,
                       mao:MA_style ,
                       mao:MA_syllabus ,
                       mao:MA_system ;
           rdfs:range mao:training_method ;
           mao:ontoMA_name_zh "采用"@zh-hk ;
           rdfs:comment "The property adopts is essentially the verb adopt, signifying that a martial arts system or style adopts a training method, or a transmission institute or syllabus adopts a training method."@en ;
           rdfs:label "adopts" .


###  http://EncodingActs.github.io/annotated/MAon/belongs_to
mao:belongs_to rdf:type owl:ObjectProperty ;
               rdfs:domain mao:MA_style ,
                           mao:MA_system ;
               rdfs:range mao:MA_system ;
               rdfs:label "belongs_to" .


###  http://EncodingActs.github.io/annotated/MAon/creates
mao:creates rdf:type owl:ObjectProperty ;
            rdfs:domain mao:MA_Master ;
            rdfs:range mao:MA_style ,
                       mao:MA_syllabus ,
                       mao:armament ,
                       mao:training_method ,
                       mao:training_tool ;
            mao:ontoMA_name_zh "創造"@zh-hk ;
            mao:ontoMA_otherName_zh "創建"@zh-hk ;
            rdfs:comment "The creates property refers to the relation that a Master creates certain (new) techniques, training methods like forms and form sets, weapons, training tools, or even a style or system."@en ;
            rdfs:label "creates" .


###  http://EncodingActs.github.io/annotated/MAon/developed_from
mao:developed_from rdf:type owl:ObjectProperty ;
                   rdfs:domain mao:MA_style ;
                   rdfs:range mao:MA_style ;
                   rdfs:label "developed_from"@en .


###  http://EncodingActs.github.io/annotated/MAon/documents
mao:documents rdf:type owl:ObjectProperty ;
              rdfs:domain mao:MA_Book ;
              rdfs:range mao:MA_Master ,
                         mao:MA_institute ,
                         mao:MA_style ,
                         mao:MA_system ,
                         mao:MA_technique ,
                         mao:training_method ;
              mao:ontoMA_name_zh "記錄"@zh-hk ;
              rdfs:label "documents" .


###  http://EncodingActs.github.io/annotated/MAon/employs
mao:employs rdf:type owl:ObjectProperty ;
            rdfs:domain mao:MA_technique ;
            rdfs:range mao:MA_technique ;
            mao:ontoMA_name_zh "Instances of Techniques, particularly Combo_tech, acquire the identity of a combo technique with a collective impact of its technical components. To capture these characteristics, we use the employs property to indicate that a more complex instance of Technique is fulfilled by employing another or several other basic ones."@en ,
                               "運用"@zh-hk ;
            rdfs:label "employs" .


###  http://EncodingActs.github.io/annotated/MAon/employsBodyshape
mao:employsBodyshape rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf mao:employs ;
                     rdfs:domain mao:MA_technique ;
                     rdfs:range mao:body_shape ;
                     rdfs:comment "Specifies the overall body configuration (身型) employed during a technique. Subproperty of mao:employs."@en ;
                     rdfs:label "employsBodyshape"@en ,
                                "運用身形"@zh-hk .


###  http://EncodingActs.github.io/annotated/MAon/employsGesture
mao:employsGesture rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf mao:employs ;
                   rdfs:domain mao:MA_technique ;
                   rdfs:range mao:gesture ;
                   rdfs:comment "Specifies the hand shape (手型) employed by a technique. Subproperty of mao:employs, narrowing the range to mao:gesture."@en ;
                   rdfs:label "employsGesture"@en ,
                              "運用手形"@zh-hk .


###  http://EncodingActs.github.io/annotated/MAon/employsStance
mao:employsStance rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf mao:employs ;
                  rdfs:domain mao:MA_technique ;
                  rdfs:range mao:stance ;
                  rdfs:comment "Specifies the stance (步形) employed during a technique. Subproperty of mao:employs."@en ;
                  rdfs:label "employsStance"@en ,
                             "運用步形"@zh-hk .


###  http://EncodingActs.github.io/annotated/MAon/has
mao:has rdf:type owl:ObjectProperty ;
        rdfs:domain mao:MA_style ,
                    mao:MA_system ;
        rdfs:range mao:MA_style ,
                   mao:MA_syllabus ;
        rdfs:label "has" .


###  http://EncodingActs.github.io/annotated/MAon/hasStyle
mao:hasStyle rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf mao:used_in ;
             rdfs:domain mao:MA_technique ;
             rdfs:range mao:MA_style ;
             rdfs:comment "Indicates that a technique instance belongs to or is characteristic of a specific martial arts style. Declared as a subproperty of mao:used_in, which has the same domain/range but broader coverage."@en ;
             rdfs:label "hasStyle"@en ,
                        "属于流派"@zh-hk .


###  http://EncodingActs.github.io/annotated/MAon/has_birthplace
mao:has_birthplace rdf:type owl:ObjectProperty ;
                   rdfs:domain mao:MA_Master ;
                   rdfs:range mao:E53_place ;
                   rdfs:label "has_birthplace" .


###  http://EncodingActs.github.io/annotated/MAon/has_component
mao:has_component rdf:type owl:ObjectProperty ;
                  rdfs:domain mao:MA_form ,
                              mao:MA_syllabus ;
                  rdfs:range mao:MA_technique ;
                  mao:ontoMA_name_zh "包含"@zh-hk ;
                  rdfs:comment "A form, whether static or dynamic, is a choreographed pattern of movement comprising a unitary sequence of basic techniques. Hence, the conventional interpretation is that a form has several technical components while simultaneously serving as a training tool for those techniques and the qualities relevant to fulfilling them. The property has component is used; it is designed to inherit the CIDOC-CRM declaration of P148 has component and to indicate the relationship between a form and the technique(s) trained within."@en ;
                  rdfs:label "has_component" .


###  http://EncodingActs.github.io/annotated/MAon/has_film_appearance
mao:has_film_appearance rdf:type owl:ObjectProperty ;
                        rdfs:domain mao:MA_Master .


###  http://EncodingActs.github.io/annotated/MAon/has_intent
mao:has_intent rdf:type owl:ObjectProperty ;
               rdfs:domain mao:MA_form ,
                           mao:MA_technique ;
               rdfs:range mao:MA_tactic ;
               mao:ontoMA_name_zh "意圖"@zh-hk ;
               rdfs:comment "The class MA_Tactic addresses the former case, in combination with the property has intent to describe an instance of Form or Technique that embodies the intent to achieve specific tactics, such as attacking, defending, deflecting, controlling distance, or complex maneuvers."@en ;
               rdfs:label "has_intent" .


###  http://EncodingActs.github.io/annotated/MAon/has_origin_place
mao:has_origin_place rdf:type owl:ObjectProperty ;
                     rdfs:domain mao:MA_style ,
                                 mao:MA_system ;
                     rdfs:range mao:E53_place ;
                     rdfs:label "has_origin_place" .


###  http://EncodingActs.github.io/annotated/MAon/has_photo
mao:has_photo rdf:type owl:ObjectProperty ;
              rdfs:domain mao:MA_Master .


###  http://EncodingActs.github.io/annotated/MAon/has_principle
mao:has_principle rdf:type owl:ObjectProperty ;
                  rdfs:domain mao:MA_style ,
                              mao:MA_system ;
                  rdfs:range mao:MA_principle ;
                  mao:ontoMA_name_zh "有原則"@zh-hk ;
                  rdfs:label "has_principle" .


###  http://EncodingActs.github.io/annotated/MAon/has_symbol
mao:has_symbol rdf:type owl:ObjectProperty ;
               rdfs:domain mao:MA_style ,
                           mao:MA_system ;
               rdfs:range mao:symbolic_animal ;
               mao:ontoMA_name_zh "有象徵"@zh-hk ;
               rdfs:label "has_symbol" .


###  http://EncodingActs.github.io/annotated/MAon/has_work
mao:has_work rdf:type owl:ObjectProperty ;
             rdfs:domain mao:MA_Master ;
             rdfs:range mao:MA_Book ;
             mao:ontoMA_name_zh "有作品"@zh-hk ;
             rdfs:label "has_work"@en .


###  http://EncodingActs.github.io/annotated/MAon/identified_by
mao:identified_by rdf:type owl:ObjectProperty ;
                  rdfs:domain mao:E21_Person ;
                  rdfs:range mao:E41_appellation ;
                  rdfs:label "identified_by" .


###  http://EncodingActs.github.io/annotated/MAon/imitates
mao:imitates rdf:type owl:ObjectProperty ;
             rdfs:range mao:symbolic_animal ;
             mao:ontoMA_name_zh "模仿"@zh-hk ;
             rdfs:comment "Certain techniques, forms, or styles are considered to imitate specific creatures or living things, for instance, through their relation to classes like symbolic_animal"@en ;
             rdfs:label "imitates"@en .


###  http://EncodingActs.github.io/annotated/MAon/in_form
mao:in_form rdf:type owl:ObjectProperty ;
            rdfs:domain mao:MA_form ;
            rdfs:range mao:Form_set ;
            mao:ontoMA_name_zh "在套路中"@zh-hk ;
            rdfs:label "in_form" .


###  http://EncodingActs.github.io/annotated/MAon/influences
mao:influences rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain mao:MA_style ,
                           mao:MA_system ;
               rdfs:range mao:MA_style ,
                          mao:MA_system ;
               rdfs:label "influences" .


###  http://EncodingActs.github.io/annotated/MAon/is
mao:is rdf:type owl:ObjectProperty ;
       rdfs:label "is" .


###  http://EncodingActs.github.io/annotated/MAon/is_child_of
mao:is_child_of rdf:type owl:ObjectProperty ;
                rdfs:label "is_child_of" .


###  http://EncodingActs.github.io/annotated/MAon/is_master_of
mao:is_master_of rdf:type owl:ObjectProperty ;
                 rdfs:domain mao:MA_Master ;
                 rdfs:range mao:MA_Master ;
                 rdfs:label "is_master_of" .


###  http://EncodingActs.github.io/annotated/MAon/is_member_of
mao:is_member_of rdf:type owl:ObjectProperty ;
                 rdfs:domain mao:MA_Master ;
                 rdfs:range mao:MA_Clan ;
                 rdfs:label "is_member_of" .


###  http://EncodingActs.github.io/annotated/MAon/is_parent_of
mao:is_parent_of rdf:type owl:ObjectProperty ;
                 rdfs:domain mao:MA_Master ;
                 rdfs:range mao:MA_Master ;
                 rdfs:label "is_parent_of" .


###  http://EncodingActs.github.io/annotated/MAon/is_student_of
mao:is_student_of rdf:type owl:ObjectProperty ;
                  rdfs:domain mao:MA_Master ;
                  rdfs:range mao:MA_Master ;
                  rdfs:label "is_student_of" .


###  http://EncodingActs.github.io/annotated/MAon/lives_in_ts
mao:lives_in_ts rdf:type owl:ObjectProperty ;
                rdfs:domain mao:MA_Master ;
                rdfs:range mao:E52_timespan ;
                rdfs:label "lives_in_ts" .


###  http://EncodingActs.github.io/annotated/MAon/located_at
mao:located_at rdf:type owl:ObjectProperty ;
               rdfs:domain mao:MA_institute ;
               rdfs:range mao:E53_place ;
               rdfs:label "located_at"@en .


###  http://EncodingActs.github.io/annotated/MAon/practiced_in
mao:practiced_in rdf:type owl:ObjectProperty ;
                 rdfs:domain mao:Form_set ;
                 rdfs:range mao:MA_style ;
                 mao:ontoMA_name_zh "習練于"@zh-hk ;
                 rdfs:comment "The practiced_in property signifies that an instance of Form_set is practised in a specific style."@en ;
                 rdfs:label "practiced_in" .


###  http://EncodingActs.github.io/annotated/MAon/practices
mao:practices rdf:type owl:ObjectProperty ;
              rdfs:domain mao:MA_Master ;
              rdfs:range mao:MA_style ,
                         mao:MA_system ;
              mao:ontoMA_name_zh "習練"@zh-hk ;
              rdfs:comment "The practices property signifies that a Master is known to practise a certain style or system."@en ;
              rdfs:label "practices" .


###  http://EncodingActs.github.io/annotated/MAon/represents
mao:represents rdf:type owl:ObjectProperty ;
               rdfs:domain mao:MA_form ;
               rdfs:range mao:MA_principle ;
               mao:ontoMA_name_zh "體現"@zh-hk ;
               rdfs:comment """The execution of a form, occasionally a technique alone, represents certain tactical intents or guiding principles underlying the movement rationale of a martial arts style. The property represents is used to connect an instance of Form to one of MA_principle, indicating that the technical movements follow a specific guiding principle or a combination of several.
The property represents in MAon shares a similar interpretation with the P138 represents declared in CIDOC-CRM. However, their domains differ, as observed thus far. The represents here establishes connections between two E89 Propositional Objects, typically linking one E89 Propositional Object with an E28 Conceptual Object."""@en ;
               rdfs:label "represents" .


###  http://EncodingActs.github.io/annotated/MAon/resides_in
mao:resides_in rdf:type owl:ObjectProperty ;
               rdfs:domain mao:MA_Master ;
               rdfs:range mao:E53_place ;
               rdfs:label "resides_in" .


###  http://EncodingActs.github.io/annotated/MAon/similar_movement_to
mao:similar_movement_to rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdf:type owl:FunctionalProperty ,
                                 owl:SymmetricProperty ,
                                 owl:TransitiveProperty ;
                        rdfs:domain mao:MA_form ;
                        rdfs:range mao:MA_form ;
                        mao:ontoMA_name_zh "The similar_movement_to property represents a conceptual similarity between instances of Form."@en ,
                                           "相似動作"@zh-hk ;
                        rdfs:label "similar_movement_to" .


###  http://EncodingActs.github.io/annotated/MAon/similar_set_of
mao:similar_set_of rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdf:type owl:SymmetricProperty ,
                            owl:TransitiveProperty ;
                   rdfs:domain mao:Form_set ;
                   rdfs:range mao:Form_set ;
                   mao:ontoMA_name_zh "相似套路"@zh-hk ;
                   rdfs:comment "The similar_set_to property represents a conceptual similarity between instances of Form_set."@en ;
                   rdfs:label "similar_set_to"@en .


###  http://EncodingActs.github.io/annotated/MAon/similar_to
mao:similar_to rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain mao:MA_technique ;
               rdfs:range mao:MA_technique ;
               mao:ontoMA_name_zh "相似"@zh-hk ;
               rdfs:comment "The similar_to property represents a conceptual similarity between instances of Technique."@en ;
               rdfs:label "similar_to" .


###  http://EncodingActs.github.io/annotated/MAon/simulates
mao:simulates rdf:type owl:ObjectProperty ;
              rdfs:domain mao:training_tool ;
              rdfs:range mao:armament ;
              mao:ontoMA_name_zh "模擬"@zh-hk ;
              rdfs:comment "Training tools refer to objects created to simulate a weapon, or part of it, to train a specific technique or physical qualities. The property simulates is utilized to indicate a possible analogy"@en ;
              rdfs:label "simulates"@en .



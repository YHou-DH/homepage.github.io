             :name_en "Eye technique"@en ;
             mao:ontoMA_name_zh "眼法"@zh ;
             rdfs:comment "Eye technique (眼法) refers to the discipline of eye-gaze direction and focus during combat or form execution, considered an integral part of coordinated body expression in many Chinese martial arts styles."@en ;
             rdfs:label "Eye_tech"@en .



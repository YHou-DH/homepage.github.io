                             [ rdf:type owl:Restriction ;
                               owl:onProperty mao:taught_at ;
                               owl:someValuesFrom mao:MA_institute
                             ] ;
             :name_en "Martial Arts Style"@en ;
             mao:ontoMA_name_zh "武術流派"@zh-hk ;
             mao:ontoMA_otherName_zh "武術風格"@zh-hk ;
             rdfs:comment "The class MA_style conceptualizes the individual stylistic genre of martial art. Each instance holds an umbrella term representing the style’s name, typically denoting a group of martial arts styles sharing similar kinaesthetic qualities, norms, and principles."@en ;
             rdfs:label "MA_Style"@en .


###  http://EncodingActs.github.io/annotated/MAon/MA_syllabus
mao:MA_syllabus rdf:type owl:Class ;
                :name_en "Syllabus (martial arts)"@en ;
                mao:ontoMA_name_zh "武術教學大綱"@zh-hk ;
                rdfs:comment "The term \"syllabus\" generally refers to the subjects covered in a course of study or teaching, offering a comprehensive overview or summary of the curriculum. This concept extends to martial arts contexts as well. It is important to note that certain systems or styles have well-defined and widely accepted modern syllabi, including grading and ranking systems, while many traditional martial arts systems lack a standardized approach."@en ;
                rdfs:label "MA_syllabus" .


###  http://EncodingActs.github.io/annotated/MAon/MA_system

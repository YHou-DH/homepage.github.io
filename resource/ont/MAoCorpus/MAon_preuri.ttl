                              [ rdf:type owl:Restriction ;
                                owl:onProperty mao:type_of ;
                                owl:someValuesFrom mao:handwork
                              ] ;
              :name_en "Claw technique"@en ;
              mao:ontoMA_name_zh "爪法"@zh-hk ;
              rdfs:comment "Claw techniques denote the techniques that use the hand in the shape simulating an animal's claw (such as tiger, crane, etc), and are considered fierce and effective techniques that can result in serious damage."@en ;
              rdfs:label "Claw_tech" .


###  http://EncodingActs.github.io/annotated/MAon/combo_tech
mao:combo_tech rdf:type owl:Class ;
               rdfs:subClassOf mao:MA_technique ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mao:employs ;
                                 owl:someValuesFrom mao:MA_technique
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mao:type_of ;
                                 owl:someValuesFrom mao:MA_technique
                               ] ;
               :name_en "Technique Combination"@en ;
               mao:ontoMA_name_zh "技術組合"@zh-hk ;
               mao:ontoMA_otherName_en "Combo Tech"@en ;
               rdfs:comment "The class Combo_tech denotes a  technique combination, often addressed as combo tech, that is a combination of multiple others, typically involving movements in different body segments. Instances of such techniques acquire the identity of a combo technique with a collective impact of its technical components. To capture these characteristics, the employs property is used to indicate that a more complex instance of Technique is fulfilled by employing another or several other basic ones."@en ;
               rdfs:label "Combo_tech" .


###  http://EncodingActs.github.io/annotated/MAon/elbow_tech

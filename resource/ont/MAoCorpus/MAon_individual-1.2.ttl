###  https://purl.org/maont/ontologytaming_tiger_57
mao:taming_tiger_57 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:in_form mao:Gung_Gee_Fook_Fu_Kuen ;
                    mao:similar_movement_to mao:taming_tiger_42 ;
                    rdfs:description "舉左掌至前額前方，掌心向外作擋頭；后一撤步扭身吊馬，左掌向左下劈落，同時右掌一兜。左脚疾上一步落左子午馬雙弓手，左掌心向上擋頭，右掌心向下，向前打出。"@zh-hk ;
                    rdfs:label "taming_tiger_57"@en ;
                    mao:name_en "Double reverse knife hand strike following the block"@en ;
                    mao:name_zh "一撇一劃千字手"@zh-hk .


###  https://purl.org/maont/ontologytaming_tiger_58

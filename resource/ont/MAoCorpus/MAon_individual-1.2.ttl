###  https://purl.org/maont/ontologytarget_hand
mao:target_hand rdf:type owl:NamedIndividual ,
                         mao:palm_tech ;
                mao:employs mao:blade_palm ;
                mao:used_in mao:Choy_Li_Fut ,
                            mao:Hung_Kuen ,
                            mao:White_Crane_Kungfu ;
                rdfs:comment "其原理和射箭一样：如果把手臂视为一支箭，前臂和后臂是箭杆的前后段，由手腕到肩膀形成一条直线，而手掌则是箭头，由前四根手指到手腕形成一个三角形的鏃。身体主干则是一张弓，由腰至肩形成弓两端的主要支点。由腰部带动发力通过背部肩膀到手臂最后达到指尖，以此来攻击对方的喉咙或双眼。"@zh ;
                rdfs:label "target_hand"@en ;
                mao:name_en "Target hand"@en ;
                mao:name_romanCAN "Biu Sau"@en ;
                mao:name_romanMAN "Biao Shou"@en ;
                mao:name_zh "標手"@zh-hk ;
                mao:otherName_en "Horizontal fingertip thrust"@en ,
                                 "Horizontal knife hand strike"@en ;
                mao:otherName_zh "標指"@zh-hk .



###  https://purl.org/maont/ontologycat_stance
mao:cat_stance rdf:type owl:NamedIndividual ,
                        mao:stance ;
               mao:used_in mao:Choy_Li_Fut ,
                           mao:Hung_Kuen ,
                           mao:White_Crane_Kungfu ;
               rdfs:comment "主要用途為避開對方正面攻擊，退後半步再進行反擊。重心在後腿，前腳向前輕輕地吊着，臀部腹部丹田往後收縮，而肩膀相應而自然地往前靠。前腿不能偏左或偏右，而是正前方，以便避開對方後馬上進行反擊"@zh ;
               rdfs:label "cat_stance"@en ;
               mao:name_en "Cat stance"@en ;
               mao:name_romanCAN "Diu Maa"@en ;
               mao:name_romanMAN "Diao Ma"@en ;
               mao:name_zh "吊馬"@zh-hk ;
               mao:otherName_en "Diu Maa"@en ,
                                "Hanging stance"@en ;
               mao:otherName_zh "吊脚"@zh-hk ,
                                "虛步"@zh-hk .



###  https://purl.org/maont/ontologyside_elbow
mao:side_elbow rdf:type owl:NamedIndividual ,
                        mao:elbow_tech ;
               mao:used_in mao:Hung_Kuen ,
                           mao:White_Crane_Kungfu ;
               rdfs:comment """頂踭是一個手踭向橫頂的攻擊手法，有兩種應用方式。第一個是攻擊對方正面，手踭攻擊對方心口；第二個是攻擊對方側面，手踭橫頂攻擊對方肋骨位置
做的時候要先放鬆身體，直到接觸目標時才收緊肌肉。循弧形軌道移動身體重心，將手收至胸前停下，並以手踭作攻擊。"""@zh-hk ;
               rdfs:label "side_elbow"@en ;
               mao:name_en "Side elbow strike"@en ;
               mao:name_romanCAN "Ding Zaang"@en ;
               mao:name_romanMAN "Ding Zhou"@en ;
               mao:name_zh "頂踭"@zh-hk ;
               mao:otherName_zh "橫踭"@zh-hk ;
               mao:otherName_zh "橫頂踭"@zh-hk .



                    mao:similar_movement_to mao:taming_tiger_41 ;
                    rdfs:description "雙手冚下雙膀手，接右掌向上一撥挑手，掌心向内平肩，同時左掌微按于腰前；后換練左掌向上挑手，右掌微按腰前。"@zh-hk ;
                    rdfs:label "taming_tiger_56"@en ;
                    mao:name_en "Double lower forearm block followed by splitting hand and upper knife hand block"@en ;

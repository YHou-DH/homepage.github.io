                   rdfs:label "throwing_elbow"@en ;
                   mao:name_en "Throwing elbow strike"@en ;
                   mao:name_romanCAN "Paau Zaang"@en ;
                   mao:name_romanMAN "Pao Zhou"@en ;
                   mao:name_zh "抛踭"@zh-hk ;
                   mao:otherName_zh "直踭"@zh-hk .



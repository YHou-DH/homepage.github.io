###  https://purl.org/maont/ontologyhook_punch
mao:hook_punch rdf:type owl:NamedIndividual ,
                        mao:fist_tech ;
               mao:employs mao:bullhorn_fist ;
               mao:used_in mao:Choy_Li_Fut ,
                           mao:Hung_Kuen ;
               rdfs:comment "捎捶是攻击面积大，力度最强的手法。捎捶时容易露出破绽，若被对方迫步进马，便难以回手，所以捎捶时常以盘桥或其他手法结合，把对方的攻击范围控制，然后才施展捎捶由上 而下向对方的太阳穴或颈部击去。身体稍微向前倾，压腰时手拉高，手从上而下扫打，打向对方的颈部。步骤：压腰出手 ➡ 手臂和手腕向下扭 ➡ 从上方扫打下去"@zh ;
               rdfs:label "hook_punch"@en ;
               mao:name_en "Hook punch"@en ;
               mao:name_romanCAN "Saau Ceoi"@en ;
               mao:name_romanMAN "Shao Chui"@en ;
               mao:name_zh "捎搥"@zh-hk ;
               mao:otherName_en "Saau Cei"@en ,
                                "Sweeping strike"@en ;
               mao:otherName_zh "牛角搥"@zh-hk .



###  https://purl.org/maont/ontologyhorse_stance
mao:horse_stance rdf:type owl:NamedIndividual ,
                          mao:stance ;
                 mao:similar_to mao:out_horse_stance ;
                 mao:used_in mao:Hung_Kuen ;
                 rdfs:comment "四平馬可以分為三個方向：正面、左面和右面。做正面四平馬時，雙腳腳掌成水平線；面向左右做四平馬時，前腳腳尖和後腳腳踭應在同一條線上。"@zh ;
                 rdfs:label "fw_horse_stance"@en ;
                 mao:name_en "Forward horse stance"@en ;
                 mao:name_romanCAN "Sei Ping Maa"@en ;
                 mao:name_romanMAN "Si Ping Ma"@en ;
                 mao:name_zh "四平馬"@zh-hk ;
                 mao:otherName_zh "四平大馬"@zh-hk .


###  https://purl.org/maont/ontologyhorse_to_bow_stance

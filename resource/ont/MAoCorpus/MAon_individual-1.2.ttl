###  https://purl.org/maont/ontologytaming_tiger_1
mao:taming_tiger_1 rdf:type owl:NamedIndividual ,
                            mao:Form_move ;
                   mao:has_intent mao:breath_regulation ;
                   mao:in_form mao:Gung_Gee_Fook_Fu_Kuen ;
                   rdfs:description "預備式，身體立正，雙手自然貼身下垂，雙脚平開一寸，頸正頭平，氣沉丹田。"@zh-hk ;
                   rdfs:label "taming_tiger_1"@en ;
                   mao:name_en "Standing with the feet about one inch apart"@en ;
                   mao:name_zh "合脚離開一寸闊"@zh-hk .


###  https://purl.org/maont/ontologytaming_tiger_10
mao:taming_tiger_10 rdf:type owl:NamedIndividual ,
                             mao:Form_move ;
                    mao:has_component mao:horse_stance ;
                    mao:in_form mao:Gung_Gee_Fook_Fu_Kuen ;
                    rdfs:description "雙拳在腰，四步開馬至雙脚距月三個腳掌的長度，落身坐四平大馬，脚尖平行向前，大腿與地面平行，膝蓋不超過腳尖。"@zh-hk ;
                    rdfs:label "taming_tiger_10"@en ;
                    mao:name_en "Posing a horse stance in four steps"@en ;
                    mao:name_zh "腳肘開發落四平"@zh-hk .



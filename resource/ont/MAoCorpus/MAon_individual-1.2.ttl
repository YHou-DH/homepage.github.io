###  https://purl.org/maont/ontologybow_stance
mao:bow_stance rdf:type owl:NamedIndividual ,
                        mao:stance ;
               mao:used_in mao:Choy_Li_Fut ,
                           mao:Hung_Kuen ;
               rdfs:comment "其核心用途為進攻。在側身四平馬的基礎上，轉動盆骨和後腳，成子午馬，方便進攻時發力。做這個馬步時要避免前後兩腳踩在同一條直線上，這不但會影響盆骨的扭動，還會令人容易失去平衡。"@zh ;
               rdfs:label "bow_stance"@en ;
               mao:name_en "Bow stance"@en ;
               mao:name_romanCAN "Zi Ng Maa"@en ;
               mao:name_romanMAN "Zi Wu Ma"@en ;
               mao:name_zh "子午馬"@zh-hk ;
               mao:otherName_en "Forward stance"@en ,
                                "Gung Bou"@en ;
               mao:otherName_zh "弓步"@zh-hk .



###  https://purl.org/maont/ontologybutterfly_palm
mao:butterfly_palm rdf:type owl:NamedIndividual ,
                            mao:palm_tech ;
                   mao:employs mao:grappling_palm ,
                               mao:tiger_claw ;
                   mao:used_in mao:Choy_Li_Fut ,
                               mao:Hung_Kuen ,
                               mao:White_Crane_Kungfu ;
                   rdfs:comment "蝴蝶掌的理念是利用靈活的偏身步法避開對方的進攻，再用蝶掌給予還擊"@zh ;
                   rdfs:label "butterfly_palm"@en ;
                   mao:name_en "Butterfly palms"@en ;

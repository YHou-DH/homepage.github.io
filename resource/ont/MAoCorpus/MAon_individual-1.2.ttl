    mao:has_component mao:db_hanging_hammer ;
    mao:has_description "側掌:白方以撐掌壓向黑方腹部 | 黑方再轉用側掌打向白方腹部 | 割手:白方轉四平馬用右割手消去"@zh-hk ;
    mao:has_description "Zak zoeng: White fiqure strikes at Black fiqure's abdomen with caang zoeng (palm strike). | zak zoeng: Black figure counters with side palm strike (zak zoeng) aimed at White figure's abdomen. | Got sau: White figure shifts into sei ping maa and deflectswith right got sau."@en ;
    rdfs:label "Double_hanging_hammer_fists_A_08"@en .

###  https://purl.org/maont/ontologygffk_dc_B_08
mao:gffk_dc_B_08 rdf:type owl:NamedIndividual ,

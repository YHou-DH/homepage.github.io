###  https://purl.org/maont/ontologygffk_dc_A_10
mao:gffk_dc_A_10 rdf:type owl:NamedIndividual ,
                   mao:Form_move ;
    mao:in_form mao:gffk_dc_seqA ;
    mao:spars_against mao:gffk_dc_B_10 ;
    mao:has_component mao:gffk_dc_pair_10 ;
    mao:has_component mao:straight_punch ;
    mao:has_component mao:bow_stance ;
    mao:has_component mao:blocking_palm ;
    mao:has_description "進馬平搥:白方進左馬，右平搥打向黑方胸部，黑方左手穿橋擋住，接著出右平搥，白方再以左手獵手消去 | 白方右平搥打向黑方，黑方左手手消去，白方上右馬、黑方拉左馬"@zh-hk ;
    mao:has_description "Zeon maa ping ceoi: White figures takes a left step forwardand pulls a right punch (ping ceo) to Black figure's chestBlack fiqure blocks with left cyun kiu sau and counters withright ping ceoi, which White figure deflects with zou laap sau | Zeon maa ping ceoi: White fiqure throws a right ping ceoi at Black figure. Black fiqure deflects with zou laap sau. White figure then steps forward on the right while Black figurepulls back on the left."@en ;
    rdfs:label "Advance_with_straight_punch_A_10"@en .


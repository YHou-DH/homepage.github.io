###  https://purl.org/maont/ontologygffk_dc_A_18
mao:gffk_dc_A_18 rdf:type owl:NamedIndividual ,
                   mao:Form_move ;
    mao:in_form mao:gffk_dc_seqA ;
    mao:spars_against mao:gffk_dc_B_18 ;
    mao:has_component mao:gffk_dc_pair_18 ;
    mao:has_component mao:bullhorn_punch ;
    mao:has_description "日字搥:雙方右吊腳，白方上右雙手日字搥打向黑方腹部，黑方同時上右馬雙膀手消去 | 撒手:黑方雙撒手捉著白方上臂 | 破排手：白方以破排手將黑方的手鬆開然後攻擊黑方，黑方同樣以破排手法消去。"@zh-hk ;
    mao:has_description "Jat zl ceoi: both sides suspend right leg. White figure takes a right step forward and pulls a doube jat zi ceoi at Biack figure's abdomen, Black figure also takes a right step forward and blocks with soeng bong sau. | Laap sau: Black figure uses soeng laap sau to grab White figure's upper arms. | Po pai sau: White figure used po pai sau to loosen Black figure's grip and counters with palm strike, Black fiqure also blocks and counters with po pai sau."@en ;
    rdfs:label "Bullhorn_hammer_fist_A_18"@en .


###  https://purl.org/maont/ontologyblocking_palm
mao:blocking_palm rdf:type owl:NamedIndividual ,
                           mao:palm_tech ;
                  mao:employs mao:tiger_claw ;
                  mao:used_in mao:Hung_Kuen ;
                  rdfs:comment "白鶴拳的膀手是如鶴翅一樣擋開攻勢。做這個手法時，前腳保持不動，後腳則要跟著身體轉動，帶動前手拋上，彈開對方的攻擊。"@zh ;
                  rdfs:label "blocking_palm"@en ;
                  mao:name_en "Lower forearm block"@en ;
                  mao:name_romanCAN "Bong Sau"@en ;
                  mao:name_romanMAN "Bang Shou"@en ;
                  mao:name_zh "膀手"@zh-hk ;
                  mao:otherName_en "Bong Sau"@en .



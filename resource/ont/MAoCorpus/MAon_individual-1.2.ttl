                             mao:Hung_Kuen ;
                 rdfs:comment "掃馬為使用掃腳後的自然姿勢。後腿曲扭靠身，而前腿往前伸延，雙腳腳跟平地。其姿勢可高可低，似乎之前掃腳之勢，但實戰中很少用低掃。戰略上也可用連環掃馬，以奇招取勝。"@zh ;
                 rdfs:label "sweep_stance"@en ;
                 mao:name_en "Sweeping stance"@en ;
                 mao:name_romanCAN "Sou Maa"@en ;
                 mao:name_romanMAN "Sao Ma"@en ;
                 mao:name_zh "掃馬"@zh-hk ;
                 mao:otherName_en "Sao Maa"@en ;
                 mao:otherName_zh "僕步"@zh-hk .



    mao:has_description "Zak zoeng: White fiqure strikes at Black fiqure's abdomen with caang zoeng (palm strike). | Got sau: Black fiqure shifts his stance into sei ping maa and deflects with right got sau. | zak zoeng: Black figure counters with side palm strike (zak zoeng) aimed at White figure's abdomen."@en ;
    rdfs:label "Double_hanging_hammer_fists_B_08"@en .

###  https://purl.org/maont/ontologygffk_dc_A_09
mao:gffk_dc_A_09 rdf:type owl:NamedIndividual ,
                   mao:Form_move ;
    mao:in_form mao:gffk_dc_seqA ;
    mao:spars_against mao:gffk_dc_B_09 ;

###  https://purl.org/maont/ontologytiger_claw
mao:tiger_claw rdf:type owl:NamedIndividual ,
                        mao:claw_tech ;
               mao:employs mao:claw_palm ;
               mao:used_in mao:Choy_Li_Fut ,
                           mao:Hung_Kuen ,
                           mao:White_Crane_Kungfu ;
               rdfs:comment """其做法有三种：①五指用力分展，第一二指节微屈，爪背屈紧，掌心成“凸”型。②拇指弯屈并紧扣于虎口处，其余四指并拢或微分卷屈
第一二指关节，微屈腕关节。③五指分开，各指关节微屈，爪背微屈，掌心成“凹”型。""" ;
               rdfs:label "tiger_claw"@en ;
               mao:name_en "Tiger claw"@en ;
               mao:name_romanCAN "Fu Zaau"@en ;
               mao:name_romanMAN "Hu Zhao"@en ;
               mao:name_zh "虎爪"@zh-hk .



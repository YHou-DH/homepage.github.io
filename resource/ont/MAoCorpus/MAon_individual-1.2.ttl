#    mao:gffk_dc_B_{N:02d}  Black figure (Side B)
#
#    has_component:
#      - mao:gffk_dc_pair_{N:02d}  (shared named pair — carries the name)
#      - side-specific technique individuals
#
#    No name_en / name_zh on Form_move — name lives on the combo_tech.
#    rdfs:label is a positional slug only.

###  https://purl.org/maont/ontologythrowing_palm
mao:throwing_palm rdf:type owl:NamedIndividual ,
                           mao:palm_tech ;
                  mao:used_in mao:White_Crane_Kungfu ;
                  rdfs:comment "摔手分單摔手和橫摔手。做單摔手時要放鬆肩膊，利用身體重心轉移幫助發力。例如做右摔手時，應先將身體偏向左邊，繼而偏向右將重心移回中線，同時將手用力摔出去。做這個動作的時候可以想像成要將手上沾著的水甩走。橫摔手的動作形態像白鶴展翅。雙手打開時十指張開，注意手臂不要拉至膊頭後。手摔向兩旁時，鬆胯令身體向下沉。"@zh ;
                  rdfs:label "throwing_palm"@en ;
                  mao:name_en "Throwing palm"@en ;
                  mao:name_romanCAN "Seot Sau"@en ;
                  mao:name_romanMAN "Shuai Shou"@en ;
                  mao:name_zh "摔手"@zh-hk ;
                  mao:otherName_en "Wrist Flicking Hand"@en .


###  https://purl.org/maont/ontologythrust_punch
mao:thrust_punch rdf:type owl:NamedIndividual ,
                          mao:fist_tech ;
                 mao:employs mao:fore_knuckle_fist ;
                 mao:used_in mao:Choy_Li_Fut ;
                 rdfs:comment "插捶是以直线向前方或斜下方刺去，握法是“姜子捶”。插捶分为阴阳两种，如直线发力插出称为阳捶，桥手扭曲旋转插 出称为阴捶。在实战中，阴阳循环形成不同角度攻击敌人上下不同部位。"@zh ;
                 rdfs:label "thrust_punch"@en ;
                 mao:name_en "Thrust punch"@en ;
                 mao:name_romanCAN "Caap Ceoi"@en ;
                 mao:name_romanMAN "Cha Chui"@en ;
                 mao:name_zh "插捶"@zh-hk .


###  https://purl.org/maont/ontologythrusting_palm
mao:thrusting_palm rdf:type owl:NamedIndividual ,
                            mao:palm_tech ;
                   mao:employs mao:reverse_palm ;
                   mao:used_in mao:Choy_Li_Fut ,
                               mao:Hung_Kuen ,
                               mao:White_Crane_Kungfu ;
                   rdfs:comment "即以指尖插擊對方的太陽穴。以腰轉動帶動上肢，以弧形進攻。後手要完全放鬆並自然隨腰後。在攻擊瞬間脊柱要微曲，以加強攻擊力。"@zh ;
                   rdfs:label "thrusting_palm"@en ;
                   mao:name_en "Palm thrust"@en ;
                   mao:name_romanCAN "Caap Zoeng"@en ;
                   mao:name_romanMAN "Cha Zhang"@en ;
                   mao:name_zh "插掌"@zh-hk ;
                   mao:otherName_en "palm_thrust"@en ;
                   mao:otherName_zh "扱手"@zh-hk .



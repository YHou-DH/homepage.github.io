                                mao:Hung_Kuen ;
                    rdfs:comment "穿橋是洪拳最基本的擋格動作。面對迎面而來的直線攻擊時，手腕通過中線，從下而上劃半圓，以前臂阻擋攻擊。做的時候沉踭對膊，有助發力。"@zh ;
                    rdfs:label "crossing_bridge"@en ;
                    mao:name_en "Crossing bridge"@en ;
                    mao:name_romanCAN "Cyun Kiu Sau"@en ;
                    mao:name_romanMAN "Chuan Qiao"@en ;

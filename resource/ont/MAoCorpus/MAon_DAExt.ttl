@prefix : <https://purl.org/maont/daext/> .
@prefix hda: <https://purl.org/maont/daext/> .
@prefix mao: <https://purl.org/maont/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

@base <https://purl.org/maont/daext/> .

<https://purl.org/hkmala/ontology/maon-daext>
    rdf:type owl:Ontology ;

    ## ── Identity ──────────────────────────────────────────────────
    vann:preferredNamespaceUri "https://purl.org/maont/daext/"^^xsd:anyURI ;
    vann:preferredNamespacePrefix "hda"^^xsd:string ;

    ## ── Imports ───────────────────────────────────────────────────
    owl:imports <https://purl.org/maont/ontology/> ;

    ## ── Versioning ────────────────────────────────────────────────
    owl:versionIRI <https://purl.org/hkmala/ontology/maon-daext> ;
    owl:versionInfo "1.0"^^xsd:string ;

    ## ── Labels & description ──────────────────────────────────────
    dc:title "MAon Digital Archive Extension"@en ;
    rdfs:label "MAon Digital Archive Extension"@en ;
    rdfs:comment "This extension imports MAon and adds a file/archive layer for HKMALA."@en ;
    dcterms:description "A provisional digital archive extension of MAon for modelling HKMALA archive-level entities, digital documents, moving-image resources, motion-capture-derived outputs, textual records, installations, exhibitions, agents, and file-level relations for Linked Art alignment."@en ;

    ## ── License ───────────────────────────────────────────────────
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;

    ## ── Provenance ────────────────────────────────────────────────
    dcterms:creator [
        rdf:type foaf:Person ;
        foaf:name "Luyi Chen"^^xsd:string ;
        foaf:homepage <https://orcid.org/0009-0002-4630-7457>
    ] ;
    dcterms:contributor [
        rdf:type foaf:Person ;
        foaf:name "Yumeng Hou"^^xsd:string ;
        foaf:homepage <https://orcid.org/0000-0002-7908-0693>
    ] ;
    dcterms:contributor [
        rdf:type foaf:Person ;
        foaf:name "Xiaoyu Zhang"^^xsd:string ;
        foaf:homepage <https://orcid.org/0000-0002-8057-3997>
    ] ;
    dcterms:created "2025-01-01"^^xsd:date ;
    dcterms:issued "2025-01-01"^^xsd:date ;
    dcterms:publisher "National University of Singapore"^^xsd:string ;

    ## ── Citation ──────────────────────────────────────────────────
    dcterms:bibliographicCitation "MAon Digital Archive Extension (v1.0). https://purl.org/hkmala/ontology/maon-daext"^^xsd:string ;

    ## ── Status & source ───────────────────────────────────────────
    bibo:status "unstable"^^xsd:string ;
    dcterms:source <https://purl.org/hkmala/ontology/maon-daext> .


#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  https://purl.org/maont/ontologyname_en
mao:name_en rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://purl.org/maont/daext/associatedWith
hda:associatedWith rdf:type owl:ObjectProperty ;
                   rdfs:domain hda:Archive_component ;
                   rdfs:range hda:Archive_component ;
                   rdfs:comment "Connects an archive component to another related archive component, such as a MoCap-derived output associated with an interactive system or installation."@en .


###  https://purl.org/maont/daext/createdBy
hda:createdBy rdf:type owl:ObjectProperty ;
              rdfs:domain hda:Digital_document ;
              rdfs:range hda:Agent ;
              rdfs:comment "Creator, producer, visual artist, or institution responsible for creating the digital file."@en ;
              rdfs:label "created_by"@en ;
              skos:prefLabel "created_by"@en ;
              mao:name_en "created by"@en .


###  https://purl.org/maont/daext/derivedFrom
hda:derivedFrom rdf:type owl:ObjectProperty ;
                rdfs:domain hda:Digital_document ;
                rdfs:range hda:Digital_document ;
                rdfs:comment "Indicates that a processed file is derived from another file or raw data."@en ;
                rdfs:label "derived_from"@en ;
                skos:prefLabel "derived_from"@en ;
                mao:name_en "derived from"@en .


###  https://purl.org/maont/daext/documents
hda:documents rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf mao:documents ;
              rdfs:domain hda:Digital_document ;
              rdfs:range owl:Thing ;
              rdfs:comment "Indicates that a martial arts document/media item records or documents a technique, form, style, place, institution, or training content."@en ;
              rdfs:label "documents"@en ;
              skos:prefLabel "documents"@en ;
              mao:name_en "documents"@en .


###  https://purl.org/maont/daext/documentsStyle
hda:documentsStyle rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf hda:documents ;
                   rdfs:domain hda:Digital_document ;
                   rdfs:range mao:MA_style ;
                   rdfs:comment "Connects a digital document to a martial arts style or system documented by the file."@en ;
                   rdfs:label "documents_style"@en ;
                   skos:prefLabel "documents_style"@en ;
                   mao:name_en "documents style"@en .


###  https://purl.org/maont/daext/documentsTechnique
hda:documentsTechnique rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf hda:documents ;
                       rdfs:domain hda:Digital_document ;
                       rdfs:range mao:MA_technique ;
                       rdfs:comment "Connects a digital document to a martial arts technique documented or demonstrated by the file."@en ;
                       rdfs:label "documents_technique"@en ;
                       skos:prefLabel "documents_technique"@en ;
                       mao:name_en "documents technique"@en .


###  https://purl.org/maont/daext/featuresMaster
hda:featuresMaster rdf:type owl:ObjectProperty ;
                   rdfs:domain hda:Digital_document ;
                   rdfs:range mao:MA_master ;
                   rdfs:comment "Master or practitioner visually shown, captured, or featured in the file as the filmed/captured subject."@en ;
                   rdfs:label "features_master"@en ;
                   skos:prefLabel "features_master"@en ;
                   mao:name_en "features master"@en .


###  https://purl.org/maont/daext/featuresObject
hda:featuresObject rdf:type owl:ObjectProperty ;
                   rdfs:domain hda:Digital_document ;
                   rdfs:range owl:Thing ;
                   rdfs:comment "Weapon or physical object shown, used, or associated with the file."@en ;
                   rdfs:label "features_object"@en ;
                   skos:prefLabel "features_object"@en ;
                   mao:name_en "features object"@en .


###  https://purl.org/maont/daext/hasArchiveComponent
hda:hasArchiveComponent rdf:type owl:ObjectProperty ;
                        owl:inverseOf hda:memberOfArchive ;
                        rdfs:domain hda:Digital_Archive ;
                        rdfs:range hda:Archive_component ;
                        rdfs:comment "Connects a digital archive to a managed archive component."@en ;
                        rdfs:label "has_archive_component"@en ;
                        skos:prefLabel "has_archive_component"@en ;
                        mao:name_en "has archive component"@en .


###  https://purl.org/maont/daext/hasArtist
hda:hasArtist rdf:type owl:ObjectProperty ;
              rdfs:domain hda:New_media_installation ;
              rdfs:range hda:Agent ;
              rdfs:label "has_artist"@en ;
              skos:prefLabel "has_artist"@en ;
              mao:name_en "has artist"@en .


###  https://purl.org/maont/daext/hasCollaborator
hda:hasCollaborator rdf:type owl:ObjectProperty ;
                    rdfs:domain hda:Archive_component ;
                    rdfs:range hda:Agent ;
                    rdfs:comment "Connects a digital archive to collaborating agents or institutions involved in its development or maintenance."@en ;
                    rdfs:label "has_collaborator"@en ;
                    skos:prefLabel "has_collaborator"@en ;
                    mao:name_en "has collaborator"@en .


###  https://purl.org/maont/daext/hasCurator
hda:hasCurator rdf:type owl:ObjectProperty ;
               rdfs:domain hda:Exhibition ;
               rdfs:range hda:Agent ;
               rdfs:label "has_curator"@en ;
               skos:prefLabel "has_curator"@en ;
               mao:name_en "has curator"@en .


###  https://purl.org/maont/daext/hasFormat
hda:hasFormat rdf:type owl:ObjectProperty ;
              rdfs:domain hda:New_media_installation ;
              rdfs:range skos:Concept ;
              rdfs:label "has_format"@en ;
              skos:prefLabel "has_format"@en ;
              mao:name_en "has format"@en .


###  https://purl.org/maont/daext/hasMemberDocument
hda:hasMemberDocument rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf hda:hasArchiveComponent ;
                      rdfs:domain hda:Digital_Archive ;
                      rdfs:range hda:Digital_document ;
                      rdfs:comment "Connects a digital archive to a digital document contained in or managed by the archive."@en ;
                      rdfs:label "has_member_document"@en ;
                      skos:prefLabel "has_member_document"@en ;
                      mao:name_en "has member document"@en .


###  https://purl.org/maont/daext/hasOrganizer
hda:hasOrganizer rdf:type owl:ObjectProperty ;
                 rdfs:domain hda:Exhibition ;
                 rdfs:range hda:Agent ;
                 rdfs:label "has_organizer"@en ;
                 skos:prefLabel "has_organizer"@en ;
                 mao:name_en "has organizer"@en .


###  https://purl.org/maont/daext/hasProcessingStage
hda:hasProcessingStage rdf:type owl:ObjectProperty ;
                       rdfs:domain hda:MoCap_item ;
                       rdfs:range skos:Concept ;
                       rdfs:label "has_processing_stage"@en ;
                       skos:prefLabel "has_processing_stage"@en ;
                       mao:name_en "has processing stage"@en .


###  https://purl.org/maont/daext/hasVenuePlace
hda:hasVenuePlace rdf:type owl:ObjectProperty ;
                  rdfs:domain hda:Exhibition ;
                  rdfs:range mao:E53_place ;
                  rdfs:comment "Connects an exhibition record to a place individual used as its venue for Linked Art alignment."@en ;
                  rdfs:label "has_venue_place"@en ;
                  skos:prefLabel "has_venue_place"@en ;
                  mao:name_en "has venue place"@en .


###  https://purl.org/maont/daext/memberOfArchive
hda:memberOfArchive rdf:type owl:ObjectProperty ;
                    rdfs:domain hda:Archive_component ;
                    rdfs:range hda:Digital_Archive ;
                    rdfs:comment "Connects an archive component to the digital archive that manages or contains it."@en ;
                    rdfs:label "member_of_archive"@en ;
                    skos:prefLabel "member_of_archive"@en ;
                    mao:name_en "member of archive"@en .


###  https://purl.org/maont/daext/present_at
hda:present_at rdf:type owl:ObjectProperty ;
               rdfs:domain hda:New_media_installation ;
               rdfs:range hda:Exhibition ;
               rdfs:comment "Installation, system, or digital-physical work appeared in or was used for an exhibition."@en ;
               rdfs:label "present_at"@en ;
               skos:prefLabel "present_at"@en ;
               mao:name_en "present at"@en .


###  https://purl.org/maont/daext/references
hda:references rdf:type owl:ObjectProperty ;
               rdfs:domain hda:Archive_component ;
               rdfs:range owl:Thing ;
               rdfs:comment "General relation for an archive component that refers to another entity, object, concept, or resource when no more specific relation is available."@en ;
               rdfs:label "references"@en ;
               skos:prefLabel "references"@en ;
               mao:name_en "references"@en .


###  https://purl.org/maont/daext/scanOf
hda:scanOf rdf:type owl:ObjectProperty ;
           rdfs:domain hda:Digital_scan ;
           rdfs:range owl:Thing ;
           rdfs:label "scan_of"@en ;
           skos:prefLabel "scan_of"@en ;
           mao:name_en "scan of"@en .


###  https://purl.org/maont/daext/shownAt
hda:shownAt rdf:type owl:ObjectProperty ;
            rdfs:domain hda:Digital_document ;
            rdfs:range hda:Exhibition ;
            rdfs:comment "Digital file is displayed, screened, presented, or made accessible in an exhibition."@en ;
            rdfs:label "shown_at"@en ;
            skos:prefLabel "shown_at"@en ;
            mao:name_en "shown at"@en .


###  https://purl.org/maont/daext/softwareForInstallation
hda:softwareForInstallation rdf:type owl:ObjectProperty ;
                            rdfs:domain hda:Application ;
                            rdfs:range hda:New_media_installation ;
                            rdfs:label "software_for_installation"@en ;
                            skos:prefLabel "software_for_installation"@en ;
                            mao:name_en "software for installation"@en .


###  https://purl.org/maont/daext/usesDigitalFile
hda:usesDigitalFile rdf:type owl:ObjectProperty ;
                    rdfs:domain hda:New_media_installation ;
                    rdfs:range hda:Digital_document ;
                    rdfs:comment "Indicates that an installation, application, or interactive system technically uses, incorporates, or depends on a digital file as source data, media material, processed input, or display content."@en ;
                    rdfs:label "uses_digital_file"@en ;
                    skos:prefLabel "uses_digital_file"@en ;
                    mao:name_en "uses digital file"@en .


###  https://purl.org/maont/daext/usesSystemOrTechnology
hda:usesSystemOrTechnology rdf:type owl:ObjectProperty ;
                           rdfs:domain hda:New_media_installation ;
                           rdfs:range skos:Concept ;
                           rdfs:comment "Special system or technology used by the installation, such as ReActor, Linear Navigator, Object Navigator, Five Perspective, 0.5Cave, iDOME, Kinect, or AR."@en ;
                           rdfs:label "uses_system_or_technology"@en ;
                           skos:prefLabel "uses_system_or_technology"@en ;
                           mao:name_en "uses system or technology"@en .


#################################################################
#    Data properties
#################################################################

###  https://purl.org/maont/daext/capturedOn
hda:capturedOn rdf:type owl:DatatypeProperty ;
               rdfs:domain hda:Digital_document ;
               rdfs:range xsd:dateTime ;
               rdfs:label "captured_on"@en ;
               skos:prefLabel "captured_on"@en ;
               mao:name_en "captured on"@en .


###  https://purl.org/maont/daext/hasAccessURL
hda:hasAccessURL rdf:type owl:DatatypeProperty ;
                 rdfs:domain owl:Thing ;
                 rdfs:range xsd:anyURI ;
                 rdfs:label "has_access_URL"@en ;
                 skos:prefLabel "has_access_URL"@en ;
                 mao:name_en "has access URL"@en .


###  https://purl.org/maont/daext/hasCreationDate
hda:hasCreationDate rdf:type owl:DatatypeProperty ;
                    rdfs:domain hda:New_media_installation ;
                    rdfs:range xsd:date ;
                    rdfs:label "has_creation_date"@en ;
                    skos:prefLabel "has_creation_date"@en ;
                    mao:name_en "has creation date"@en .


###  https://purl.org/maont/daext/hasDescription
hda:hasDescription rdf:type owl:DatatypeProperty ;
                   rdfs:domain owl:Thing ;
                   rdfs:range rdfs:Literal ;
                   rdfs:label "has_description"@en ;
                   skos:prefLabel "has_description"@en ;
                   mao:name_en "has description"@en .


###  https://purl.org/maont/daext/hasDuration
hda:hasDuration rdf:type owl:DatatypeProperty ;
                rdfs:domain hda:Digital_document ;
                rdfs:range xsd:string ;
                rdfs:label "has_duration"@en ;
                skos:prefLabel "has_duration"@en ;
                mao:name_en "has duration"@en .


###  https://purl.org/maont/daext/hasEndDate
hda:hasEndDate rdf:type owl:DatatypeProperty ;
               rdfs:domain hda:Exhibition ;
               rdfs:range xsd:date ;
               rdfs:label "has_end_date"@en ;
               skos:prefLabel "has_end_date"@en ;
               mao:name_en "has end date"@en .


###  https://purl.org/maont/daext/hasFrameRate
hda:hasFrameRate rdf:type owl:DatatypeProperty ;
                 rdfs:domain hda:Digital_document ;
                 rdfs:range xsd:string ;
                 rdfs:label "has_frame_rate"@en ;
                 skos:prefLabel "has_frame_rate"@en ;
                 mao:name_en "has frame rate"@en .


###  https://purl.org/maont/daext/hasIdentifier
hda:hasIdentifier rdf:type owl:DatatypeProperty ;
                  rdfs:domain hda:Digital_document ;
                  rdfs:range xsd:string ;
                  rdfs:label "has_identifier"@en ;
                  skos:prefLabel "has_identifier"@en ;
                  mao:name_en "has identifier"@en .


###  https://purl.org/maont/daext/hasMeshOutputPath
hda:hasMeshOutputPath rdf:type owl:DatatypeProperty ;
                      rdfs:domain hda:MoCap_item ;
                      rdfs:range xsd:string ;
                      rdfs:label "has_mesh_output_path"@en ;
                      skos:prefLabel "has_mesh_output_path"@en ;
                      mao:name_en "has mesh output path"@en .


###  https://purl.org/maont/daext/hasRawDataPath
hda:hasRawDataPath rdf:type owl:DatatypeProperty ;
                   rdfs:domain hda:MoCap_item ;
                   rdfs:range xsd:string ;
                   rdfs:label "has_raw_data_path"@en ;
                   skos:prefLabel "has_raw_data_path"@en ;
                   mao:name_en "has raw data path"@en .


###  https://purl.org/maont/daext/hasResolution
hda:hasResolution rdf:type owl:DatatypeProperty ;
                  rdfs:domain hda:Digital_document ;
                  rdfs:range xsd:string ;
                  rdfs:label "has_resolution"@en ;
                  skos:prefLabel "has_resolution"@en ;
                  mao:name_en "has resolution"@en .


###  https://purl.org/maont/daext/hasRiggedVersionPath
hda:hasRiggedVersionPath rdf:type owl:DatatypeProperty ;
                         rdfs:domain hda:MoCap_item ;
                         rdfs:range xsd:string ;
                         rdfs:label "has_rigged_version_path"@en ;
                         skos:prefLabel "has_rigged_version_path"@en ;
                         mao:name_en "has rigged version path"@en .


###  https://purl.org/maont/daext/hasStartDate
hda:hasStartDate rdf:type owl:DatatypeProperty ;
                 rdfs:domain hda:Exhibition ;
                 rdfs:range xsd:date ;
                 rdfs:label "has_start_date"@en ;
                 skos:prefLabel "has_start_date"@en ;
                 mao:name_en "has start date"@en .


###  https://purl.org/maont/daext/hasStoragePath
hda:hasStoragePath rdf:type owl:DatatypeProperty ;
                   rdfs:domain hda:Digital_document ;
                   rdfs:range xsd:string ;
                   rdfs:label "has_storage_path"@en ;
                   skos:prefLabel "has_storage_path"@en ;
                   mao:name_en "has storage path"@en .


###  https://purl.org/maont/daext/hasTitle
hda:hasTitle rdf:type owl:DatatypeProperty ;
             rdfs:domain owl:Thing ;
             rdfs:range rdfs:Literal ;
             rdfs:label "has_title"@en ;
             skos:prefLabel "has_title"@en ;
             mao:name_en "has title"@en .


###  https://purl.org/maont/daext/hasVenue
hda:hasVenue rdf:type owl:DatatypeProperty ;
             rdfs:domain owl:Thing ;
             rdfs:range rdfs:Literal ;
             rdfs:label "has_venue"@en ;
             skos:prefLabel "has_venue"@en ;
             mao:name_en "has venue"@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class .


###  https://purl.org/maont/daext/AI_gen
hda:AI_gen rdf:type owl:Class ;
           rdfs:subClassOf hda:Animation ;
           rdfs:comment "AI-generated moving-image or animation file."@en ;
           rdfs:label "AI_gen"@en ;
           skos:prefLabel "AI_gen"@en ;
           mao:name_en "AI-generated animation"@en .


###  https://purl.org/maont/daext/Agent
hda:Agent rdf:type owl:Class ;
          rdfs:subClassOf hda:Archive_component ;
          rdfs:comment "Person, group, studio, institution, master, artist, curator, or organizer associated with archive objects."@en ;
          rdfs:label "Agent"@en ;
          skos:prefLabel "Agent"@en ;
          mao:name_en "Agent"@en .


###  https://purl.org/maont/daext/Analyzed_Rigged
hda:Analyzed_Rigged rdf:type owl:Class ;
                    rdfs:subClassOf hda:MoCap_item ;
                    rdfs:comment "MoCap data bound to skeletal rig through algorithmic processing."@en ;
                    rdfs:label "Rigged_algorithmic"@en ;
                    skos:prefLabel "Rigged_algorithmic"@en ;
                    mao:name_en "Rigged algorithmically"@en .


###  https://purl.org/maont/daext/Animation
hda:Animation rdf:type owl:Class ;
              rdfs:subClassOf hda:Video_item ;
              rdfs:comment "Generated or edited moving-image file using animation or visualization methods."@en ;
              rdfs:label "Animation"@en ;
              skos:prefLabel "Animation"@en ;
              mao:name_en "Animation"@en .


###  https://purl.org/maont/daext/Application
hda:Application rdf:type owl:Class ;
                rdfs:subClassOf hda:Digital_document ;
                rdfs:comment "Software or application file related to a digital installation or interface."@en ;
                rdfs:label "Application"@en ;
                skos:prefLabel "Application"@en ;
                mao:name_en "Application"@en .


###  https://purl.org/maont/daext/Archive_component
hda:Archive_component rdf:type owl:Class ;
                      rdfs:comment "A general class for entities that are managed as components of a digital archive, including digital documents, exhibitions, installations, and agents."@en ;
                      rdfs:label "Archive_component"@en ;
                      skos:prefLabel "Archive_component"@en ;
                      mao:name_en "Archive component"@en .


###  https://purl.org/maont/daext/Audio
hda:Audio rdf:type owl:Class ;
          rdfs:subClassOf hda:Digital_document ;
          rdfs:comment "Audio file or sound recording, including interviews, oral history, narration, ambient sound, and performance audio."@en ;
          rdfs:label "Audio"@en ;
          skos:prefLabel "Audio"@en ;
          mao:name_en "Audio"@en .


###  https://purl.org/maont/daext/Book
hda:Book rdf:type owl:Class ;
         rdfs:subClassOf hda:Textual_item ;
         rdfs:comment "Published or digitized book related to martial arts knowledge, heritage context, artists, masters, exhibitions, or archive research."@en ;
         rdfs:label "Book"@en ;
         skos:prefLabel "Book"@en ;
         mao:name_en "Book"@en .


###  https://purl.org/maont/daext/Digital_Archive
hda:Digital_Archive rdf:type owl:Class ;
                    rdfs:comment "A curated digital archive grouping digital documents, media records, exhibitions, agents, and domain entities related to martial arts heritage."@en ;
                    rdfs:label "Digital_Archive"@en ;
                    skos:prefLabel "Digital_Archive"@en ;
                    mao:name_en "Digital Archive"@en .


###  https://purl.org/maont/daext/Digital_Learning_Platform
hda:Digital_Learning_Platform rdf:type owl:Class ;
                              rdfs:subClassOf hda:Application ;
                              rdfs:comment "A digital learning platform or application that organizes and provides access to instructional videos and other learning resources."@en ;

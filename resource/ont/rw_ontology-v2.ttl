    skos:prefLabel "Other"@en .


###  --- StructuralConfiguration ---
rw:SelfSupportingWovenStructure rdf:type owl:Class ;
    rdfs:subClassOf rw:StructuralConfiguration ;
    rdfs:label "Self Supporting Woven Structure"@en ;
    skos:prefLabel "Self Supporting Woven Structure"@en ;
    skos:broader rw:StructuralConfiguration .

rw:HybridFrameAndWovenStructure rdf:type owl:Class ;
    rdfs:subClassOf rw:StructuralConfiguration ;
    rdfs:label "Hybrid Frame And Woven Structure"@en ;
    skos:prefLabel "Hybrid Frame And Woven Structure"@en ;
    skos:broader rw:StructuralConfiguration .

rw:BoundFrameStructure rdf:type owl:Class ;
    rdfs:subClassOf rw:StructuralConfiguration ;
    rdfs:label "Bound Frame Structure"@en ;
    skos:prefLabel "Bound Frame Structure"@en ;
    skos:broader rw:StructuralConfiguration .



#======================================================================
#  Object properties
#======================================================================

rw:produced_through rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P108i_was_produced_by> ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:CraftingProcess ;
    rdfs:label "produced_through"@en ;
    rdfs:comment "Links a crafted product to the production process (E12) that created it."@en .

rw:produced_by rdf:type owl:ObjectProperty ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:Craftsman ;
    rdfs:label "produced_by"@en ;
    rdfs:comment "Shortcut linking a product directly to its maker."@en .

rw:executes rdf:type owl:ObjectProperty ;
    rdfs:domain rw:Craftsman ;
    rdfs:range rw:CraftingProcess ;
    rdfs:label "executes"@en ;
    rdfs:comment "A craftsman executes a crafting process (conceptual inverse of crm:P14_carried_out_by)."@en .

rw:located_at rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location> ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:GeographicalContext ;
    rdfs:label "located_at"@en ;
    rdfs:comment "Links a crafted product to the place where it is held or originates."@en .

rw:practiced_in rdf:type owl:ObjectProperty ;
    rdfs:domain rw:RattanCraftTechnique ;
    rdfs:range rw:GeographicalContext ;
    rdfs:label "practiced_in"@en ;
    rdfs:comment "Region(s) where a technique is traditionally practiced."@en .

rw:took_place_at rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at> ;
    rdfs:domain rw:CraftingProcess ;
    rdfs:range rw:GeographicalContext ;
    rdfs:label "took_place_at"@en .

rw:has_timespan rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span> ;
    rdfs:range rw:TemporalContext ;
    rdfs:label "has_timespan"@en .

rw:has_heritage_status rdf:type owl:ObjectProperty ;
    rdfs:range rw:HeritageStatus ;
    rdfs:label "has_heritage_status"@en ;
    rdfs:comment "Links a craft practice, product, or practitioner to a heritage classification."@en .

rw:transmitted_by rdf:type owl:ObjectProperty ;
    rdfs:domain rw:RattanCraftTechnique ;
    rdfs:range rw:Craftsman ;
    rdfs:label "transmitted_by"@en ;
    rdfs:comment "Practitioner responsible for transmitting knowledge of a technique."@en .

rw:is_made_of rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P45_consists_of> ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:Material ;
    rdfs:label "is_made_of"@en ;
    rdfs:comment "The material(s) a crafted product is made of."@en .

rw:transforms_material rdf:type owl:ObjectProperty ;
    rdfs:domain rw:CraftingProcess ;
    rdfs:range rw:Material ;
    rdfs:label "transforms_material"@en .

rw:applies_technique rdf:type owl:ObjectProperty ;
    rdfs:domain rw:CraftingProcess ;
    rdfs:range rw:RattanCraftTechnique ;
    rdfs:label "applies_technique"@en ;
    rdfs:comment "A crafting process applies a rattan craft technique (workbook: involves)."@en .

rw:produces_pattern rdf:type owl:ObjectProperty ;
    rdfs:domain rw:RattanCraftTechnique ;
    rdfs:range rw:RattanWeavingPattern ;
    rdfs:label "produces_pattern"@en ;
    rdfs:comment "A technique produces a given weaving pattern."@en .

rw:employs rdf:type owl:ObjectProperty ;
    rdfs:domain rw:RattanCraftTechnique ;
    rdfs:range rw:EquipmentTool ;
    rdfs:label "employs"@en ;
    rdfs:comment "A technique employs a tool or piece of equipment."@en .

rw:requires_equipment rdf:type owl:ObjectProperty ;
    rdfs:domain rw:RattanCraftTechnique ;
    rdfs:range rw:EquipmentTool ;
    rdfs:label "requires_equipment"@en .

rw:requires_tool rdf:type owl:ObjectProperty ;
    rdfs:domain rw:RattanCraftTechnique ;
    rdfs:range rw:EquipmentTool ;
    rdfs:label "requires_tool"@en .

rw:has_component rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of> ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:ObjectComponent ;
    rdfs:label "has_component"@en ;
    rdfs:comment "A crafted product has a physical component."@en .

rw:bears_pattern_application rdf:type owl:ObjectProperty ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:ComponentApplication ;
    rdfs:label "bears_pattern_application"@en ;
    rdfs:comment "Links a product to a reified statement that a component bears a pattern."@en .

rw:on_component rdf:type owl:ObjectProperty ;
    rdfs:domain rw:ComponentApplication ;
    rdfs:range rw:ObjectComponent ;
    rdfs:label "on_component"@en ;
    rdfs:comment "The component on which a pattern application is observed."@en .

rw:applies_pattern rdf:type owl:ObjectProperty ;
    rdfs:domain rw:ComponentApplication ;
    rdfs:range rw:RattanWeavingPattern ;
    rdfs:label "applies_pattern"@en ;
    rdfs:comment "The weaving pattern recorded in a component application."@en .

rw:bears_weaving_pattern rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P130_shows_features_of> ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:RattanWeavingPattern ;
    rdfs:label "bears_weaving_pattern"@en ;
    rdfs:comment "Direct (component-agnostic) shortcut: a product bears a weaving pattern."@en .

rw:bears_motif rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P65_shows_visual_item> ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:VisualDesignMotif ;
    rdfs:label "bears_motif"@en ;
    rdfs:comment "A crafted product bears a visual design motif."@en .

rw:shows_color_dye_pattern rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P65_shows_visual_item> ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:ColorDyePattern ;
    rdfs:label "shows_color_dye_pattern"@en ;
    rdfs:comment "A crafted product shows a color/dye pattern."@en .

rw:has_structural_configuration rdf:type owl:ObjectProperty ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:StructuralConfiguration ;
    rdfs:label "has_structural_configuration"@en ;
    rdfs:comment "The overall structural construction type of a crafted product."@en .

rw:uses_integration_method rdf:type owl:ObjectProperty ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range rw:IntegrationMethod ;
    rdfs:label "uses_integration_method"@en ;
    rdfs:comment "The method by which woven elements integrate with the frame."@en .

rw:is_depicted_by rdf:type owl:ObjectProperty ;
    rdfs:domain rw:RattanWeavingPattern ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item> ;
    rdfs:label "is_depicted_by"@en ;
    rdfs:comment "A pattern is depicted by an image (reference exemplar)."@en .

#======================================================================
#  Datatype properties
#======================================================================

rw:has_object_id rdf:type owl:DatatypeProperty ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range xsd:string ;
    rdfs:label "has_object_id"@en ;
    rdfs:comment "Local identifier of the 3D object record."@en .

rw:has_3d_data_path rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:anyURI ;
    rdfs:label "has_3d_data_path"@en ;
    rdfs:comment "Path to a 3D asset (.glb/.gltf/.obj/.ply/.fbx/.usdz)."@en .

rw:has_image_path rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:anyURI ;
    rdfs:label "has_image_path"@en ;
    rdfs:comment "Path to a 2D image asset."@en .

rw:has_caption rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has_caption"@en ;
    rdfs:comment "Caption or region description for an image."@en .

rw:has_annotator_note rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has_annotator_note"@en ;
    rdfs:comment "Free-text note recorded by the annotator."@en .

rw:has_specific_tool_name rdf:type owl:DatatypeProperty ;
    rdfs:domain rw:EquipmentTool ;
    rdfs:range xsd:string ;
    rdfs:label "has_specific_tool_name"@en ;
    rdfs:comment "Specific named instance of a tool type."@en .

rw:has_heritage_label rdf:type owl:DatatypeProperty ;
    rdfs:domain rw:HeritageStatus ;
    rdfs:range xsd:string ;
    rdfs:label "has_heritage_label"@en ;
    rdfs:comment "Human-readable heritage designation."@en .

rw:has_year rdf:type owl:DatatypeProperty ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range xsd:gYear ;
    rdfs:label "has_year"@en .

rw:has_size_class rdf:type owl:DatatypeProperty ;
    rdfs:domain rw:CraftedProduct ;
    rdfs:range xsd:string ;
    rdfs:label "has_size_class"@en ;
    rdfs:comment "Optional descriptive size or height variant of a product (e.g. High or Low). Recommended as the proper home for High/Low-style distinctions instead of dedicated subclasses."@en .

###  --- Annotation-derived additions ---
rw:BenchStop rdf:type owl:Class ;
    rdfs:subClassOf rw:HoldingClampingTool ;
    rdfs:label "Bench Stop"@en ;
    skos:prefLabel "Bench Stop"@en ;
    skos:broader rw:HoldingClampingTool .


###  --- Materials ---
rw:Material rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E57_Material> ;
    rdfs:label "Material"@en ;
    skos:prefLabel "Material"@en .

rw:Bamboo rdf:type owl:Class ;
    rdfs:subClassOf rw:Material ;
    rdfs:label "Bamboo"@en ;
    skos:prefLabel "Bamboo"@en ;
    skos:definition "A grass plant whose split canes are used alongside rattan in weaving."@en ;
    skos:broader rw:Material .

rw:BambooStrip rdf:type owl:Class ;
    rdfs:subClassOf rw:Bamboo ;
    rdfs:label "Bamboo Strip"@en ;

###  --- Techniques ---
rw:RattanCraftTechnique rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure> ;
    rdfs:label "Rattan Craft Technique"@en ;
    skos:prefLabel "Rattan Craft Technique"@en .

rw:MaterialPreparationTechnique rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanCraftTechnique ;
    rdfs:label "Material Preparation Technique"@en ;
    skos:prefLabel "Material Preparation Technique"@en ;
    skos:broader rw:RattanCraftTechnique .

rw:Soaking rdf:type owl:Class ;
    rdfs:subClassOf rw:MaterialPreparationTechnique ;
    rdfs:label "Soaking"@en ;
    skos:prefLabel "Soaking"@en ;
    skos:definition "Immersing rattan in water to increase flexibility prior to weaving."@en ;
    skos:broader rw:MaterialPreparationTechnique ;
    skos:altLabel "Water Soaking"@en .

rw:Heating rdf:type owl:Class ;
    rdfs:subClassOf rw:MaterialPreparationTechnique ;
    rdfs:label "Heating"@en ;
    skos:prefLabel "Heating"@en ;
    skos:definition "Applying heat to rattan to make it pliable for bending and shaping."@en ;
    skos:broader rw:MaterialPreparationTechnique .

rw:Splitting rdf:type owl:Class ;
    rdfs:subClassOf rw:MaterialPreparationTechnique ;
    rdfs:label "Splitting"@en ;
    skos:prefLabel "Splitting"@en ;
    skos:definition "Splitting rattan canes lengthwise into strips for use in flat weaving."@en ;
    skos:broader rw:MaterialPreparationTechnique .

rw:FormingTechnique rdf:type owl:Class ;

@prefix rw: <http://www.semanticweb.org/ontologies/rattan-weaving-sg/202602#> .
@prefix rw-vocab: <http://www.semanticweb.org/ontologies/rattan-weaving-sg/202602/vocab#> .
@prefix rw-data: <http://www.semanticweb.org/ontologies/rattan-weaving-sg/202602/data#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .


<http://www.semanticweb.org/ontologies/rattan-weaving-sg/202602> rdf:type owl:Ontology ;
    owl:versionInfo "2.0"@en ;
    dct:modified "2026-06-23"^^xsd:date ;
    rdfs:label "Rattan Weaving Ontology"@en ;
    rdfs:comment """An ontology for Rattan Weaving as Intangible Cultural Heritage in Singapore,
    aligned with CIDOC CRM and enriched with a SKOS thesaurus layer. Version 2.0 incorporates
    corrections and relational structures derived from the annotation of the Chun Mee Lee
    rattan furniture corpus."""@en .

#======================================================================
#  Referenced CIDOC-CRM classes
#======================================================================

<http://www.cidoc-crm.org/cidoc-crm/E12_Production> rdf:type owl:Class .
<http://www.cidoc-crm.org/cidoc-crm/E21_Person> rdf:type owl:Class .
<http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object> rdf:type owl:Class .
<http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure> rdf:type owl:Class .
<http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item> rdf:type owl:Class .
<http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span> rdf:type owl:Class .
<http://www.cidoc-crm.org/cidoc-crm/E53_Place> rdf:type owl:Class .
<http://www.cidoc-crm.org/cidoc-crm/E55_Type> rdf:type owl:Class .
<http://www.cidoc-crm.org/cidoc-crm/E57_Material> rdf:type owl:Class .

#======================================================================
#  Core classes
#======================================================================

rw:Context rdf:type owl:Class ;
    rdfs:label "Context"@en ;
    skos:prefLabel "Context"@en ;
    skos:definition "Abstract grouping for contextual entities (place, time, heritage)."@en .

rw:GeographicalContext rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E53_Place> ,
        rw:Context ;
    rdfs:label "Geographical Context"@en ;
    skos:prefLabel "Geographical Context"@en ;
    skos:definition "A place where a product originates or a technique is practiced."@en ;
    skos:broader rw:Context .

rw:TemporalContext rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span> ,
        rw:Context ;
    rdfs:label "Temporal Context"@en ;
    skos:prefLabel "Temporal Context"@en ;
    skos:definition "A period associated with a product or process."@en ;
    skos:broader rw:Context .

rw:HeritageStatus rdf:type owl:Class ;
    rdfs:subClassOf rw:Context ;
    rdfs:label "Heritage Status"@en ;
    skos:prefLabel "Heritage Status"@en ;
    skos:definition "A formal recognition of a craft practice as cultural heritage."@en ;
    skos:broader rw:Context .

rw:Craftsman rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
    rdfs:label "Craftsman"@en ;
    skos:prefLabel "Craftsman"@en ;
    skos:definition "A person skilled in the practice of rattan weaving."@en .

rw:ComponentApplication rdf:type owl:Class ;
    rdfs:label "Component Application"@en ;
    skos:prefLabel "Component Application"@en ;
    skos:definition "Reified link recording that a crafted product bears a specific weaving pattern on a specific component."@en .

rw:IntegrationMethod rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
    rdfs:label "Integration Method"@en ;
    skos:prefLabel "Integration Method"@en ;
    skos:definition "A method by which woven elements are integrated with a structural frame."@en .

rw:StructuralConfiguration rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
    rdfs:label "Structural Configuration"@en ;
    skos:prefLabel "Structural Configuration"@en ;
    skos:definition "Overall structural construction type of a crafted product."@en .

rw:ObjectComponent rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object> ;
    rdfs:label "Object Component"@en ;
    skos:prefLabel "Object Component"@en ;
    skos:definition "A distinguishable physical part of a crafted product (seat, backrest, etc.)."@en .

rw:EquipmentTool rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object> ;
    rdfs:label "Equipment Tool"@en ;
    skos:prefLabel "Equipment Tool"@en ;
    skos:definition "A tool or piece of equipment employed in a rattan-working technique."@en .

rw:RattanWeavingPattern rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure> ;
    rdfs:label "Rattan Weaving Pattern"@en ;
    skos:prefLabel "Rattan Weaving Pattern"@en ;
    skos:definition "A repeating structural or visual arrangement produced by a technique."@en .

rw:RattanBindingPattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Rattan Binding Pattern"@en ;
    skos:prefLabel "Rattan Binding Pattern"@en ;
    skos:definition "A binding-derived pattern arrangement."@en ;
    skos:broader rw:RattanWeavingPattern .

rw:RattanStructuralPattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Rattan Structural Pattern"@en ;
    skos:prefLabel "Rattan Structural Pattern"@en ;
    skos:definition "A frame/structural pattern arrangement."@en ;
    skos:broader rw:RattanWeavingPattern .

rw:VisualDesignMotif rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item> ;
    rdfs:label "Visual Design Motif"@en ;
    skos:prefLabel "Visual Design Motif"@en ;
    skos:definition "A representational or decorative motif shown on a product."@en .

rw:ColorDyePattern rdf:type owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item> ;
    rdfs:label "Color Dye Pattern"@en ;
    skos:prefLabel "Color Dye Pattern"@en ;
    skos:definition "A coloration or dye arrangement on a product surface."@en .


###  --- WeavingPatterns ---
rw:PlainWeavePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Plain Weave Pattern"@en ;
    skos:prefLabel "Plain Weave Pattern"@en ;
    skos:definition "Dense orthogonal square cells; simplest over-under interlacing."@en ;
    skos:broader rw:RattanWeavingPattern .

rw:BoxWeavePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Box Weave Pattern"@en ;
    skos:prefLabel "Box Weave Pattern"@en ;
    skos:definition "Open orthogonal square cells."@en ;
    skos:broader rw:RattanWeavingPattern .

rw:RadialWeavePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Radial Weave Pattern"@en ;
    skos:prefLabel "Radial Weave Pattern"@en ;
    skos:broader rw:RattanWeavingPattern .

rw:HexagonalWeavePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Hexagonal Weave Pattern"@en ;
    skos:prefLabel "Hexagonal Weave Pattern"@en ;
    skos:definition "Repeating six-sided open cells in a three-directional lattice."@en ;
    skos:broader rw:RattanWeavingPattern .

rw:HerringboneWeavePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Herringbone Weave Pattern"@en ;
    skos:prefLabel "Herringbone Weave Pattern"@en ;
    skos:definition "Alternating diagonal strands forming V-shaped rows."@en ;
    skos:broader rw:RattanWeavingPattern ;
    skos:altLabel "Chevron"@en .

rw:DiamondWeavePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Diamond Weave Pattern"@en ;
    skos:prefLabel "Diamond Weave Pattern"@en ;
    skos:definition "Repeating diamond-shaped openings formed by diagonal strands."@en ;
    skos:broader rw:RattanWeavingPattern .

rw:WickerWeavePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Wicker Weave Pattern"@en ;
    skos:prefLabel "Wicker Weave Pattern"@en ;
    skos:broader rw:RattanWeavingPattern .

rw:OctagonalWeavePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Octagonal Weave Pattern"@en ;
    skos:prefLabel "Octagonal Weave Pattern"@en ;
    skos:definition "Repeating eight-sided open cells connected by short bridges."@en ;
    skos:broader rw:RattanWeavingPattern .

rw:BraidedEdgePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Braided Edge Pattern"@en ;
    skos:prefLabel "Braided Edge Pattern"@en ;
    skos:definition "Multiple strands interlaced into a braid, typically at edges/rims."@en ;
    skos:broader rw:RattanWeavingPattern .

rw:CompositeWeavePattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Composite Weave Pattern"@en ;
    skos:prefLabel "Composite Weave Pattern"@en ;
    skos:broader rw:RattanWeavingPattern .

rw:SpiralCoilPattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Spiral Coil Pattern"@en ;
    skos:prefLabel "Spiral Coil Pattern"@en ;
    skos:definition "Continuous strand coiled in concentric or spiral loops."@en ;
    skos:broader rw:RattanWeavingPattern .

rw:PlainWickerPattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Plain Wicker Pattern"@en ;
    skos:prefLabel "Plain Wicker Pattern"@en ;
    skos:broader rw:RattanWeavingPattern .

rw:TwistedWickerPattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Twisted Wicker Pattern"@en ;
    skos:prefLabel "Twisted Wicker Pattern"@en ;
    skos:broader rw:RattanWeavingPattern .

rw:SlewingBandWickerPattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Slewing Band Wicker Pattern"@en ;
    skos:prefLabel "Slewing Band Wicker Pattern"@en ;
    skos:broader rw:RattanWeavingPattern .

rw:WalingWickerPattern rdf:type owl:Class ;
    rdfs:subClassOf rw:RattanWeavingPattern ;
    rdfs:label "Waling Wicker Pattern"@en ;
    skos:prefLabel "Waling Wicker Pattern"@en ;
    skos:broader rw:RattanWeavingPattern .


